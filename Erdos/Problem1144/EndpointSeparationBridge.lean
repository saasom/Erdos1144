        endpointSeparationValue X lambda a b omega =
          A omega + Z omega)
    (hT : T ≤ U)
    (hM : (1 + |lambda|) * M < T)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZflip : ∀ omega, Z (tau omega) = -Z omega)
    (hU_sq : U ^ 2 ≤ V / 2)
    (hZsecond_int : Integrable (fun omega => (Z omega) ^ 2) mu)
    (hZfourth_int : Integrable (fun omega => (Z omega) ^ 4) mu)
    (hZsecond : V ≤ ∫ omega, (Z omega) ^ 2 ∂mu)
    (hZfourth : (∫ omega, (Z omega) ^ 4 ∂mu) ≤ K * V ^ 2) :
