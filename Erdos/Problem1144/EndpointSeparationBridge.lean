structure EndpointSeparationDirectPositivePiercedScreenRealSummableCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  fail : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  fail_summable : Summable fail
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  prob_some_pair_success :
    ∀ j,
      1 - fail j ≤
        mu.real
          {omega |
            ∃ r, r ∈ indexSet j ∧
              omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)}

/-- Ordinary real summability of the pierced-screen failure sequence gives the
