all-absolute-screens failure certificate. -/
noncomputable def endpointSeparationAbsScreenCertificate_of_finiteFreshWalkTailRealBudget
    (h :
      EndpointSeparationAbsScreenTailProbabilityFiniteFreshWalkRealBudgetCertificate) :
    EndpointSeparationAbsScreenCertificate :=
