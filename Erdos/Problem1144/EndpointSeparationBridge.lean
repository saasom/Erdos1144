        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_beta_sum :
    ∀ j, countMean j ≤ ∑ _r ∈ indexSet j, beta j
  pairBudget_le_countRawSecond :
    ∀ j,
      (∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
        if r = s then tailUpper j else pairUpper j)
        ≤ countRawSecond j
  beta_le_one_over_twenty_four :
    ∀ j r, r ∈ indexSet j → beta j ≤ (1 : ℝ) / 24
  variance_pos :
    ∀ j r, r ∈ indexSet j →
      0 < ∑ p ∈ freshSet j r, coeff j r p ^ 2
  decomp :
    ∀ j r, r ∈ indexSet j →
      ∀ omega,
        endpointSeparationValue
            (fun N omega => normSum omega N) (lambda j r) (a j r) (b j r) omega =
          A j r omega + epsLinearForm (freshSet j r) (coeff j r) omega
  separation_threshold :
    ∀ j r, r ∈ indexSet j → T j r ≤ U j r
  endpoint_screen :
    ∀ j r, r ∈ indexSet j → (1 + |lambda j r|) * M j < T j r
  background_invariant :
    ∀ j r, r ∈ indexSet j →
      ∀ omega, A j r (freshSignFlip (freshSet j r) omega) = A j r omega
  fresh_threshold_sq :
    ∀ j r, r ∈ indexSet j →
      U j r ^ 2 ≤ (∑ p ∈ freshSet j r, coeff j r p ^ 2) / 2
  tail_prob_le_tailUpper :
    ∀ j r, r ∈ indexSet j →
      mu.real
          (endpointAbsPairSuccessEvent
            (fun N omega => normSum omega N) (M j) (a j r) (b j r))
        ≤ tailUpper j
  offdiag_pair_prob_le_pairUpper :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j → r ≠ s →
      mu.real (endpointAbsPairScreenJointSuccessEvent M a b j r s)
        ≤ pairUpper j

/-- Exact finite fresh-walk uniform real-budget certificates produce the
ordinary uniform real-budget screen certificate by discharging the one-point
lower tail field in Lean. -/
noncomputable def
    endpointSeparationAbsScreenUniformRealBudgetCertificate_of_finiteFreshWalkZeroRemainder
    (h :
      EndpointSeparationAbsScreenUniformFiniteFreshWalkZeroRemainderRealBudgetCertificate) :
    EndpointSeparationAbsScreenUniformRealBudgetCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  beta := h.beta
  tailUpper := h.tailUpper
  pairUpper := h.pairUpper
  countMean := h.countMean
  countRawSecond := h.countRawSecond
  failBound := h.failBound
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  failBound_summable := h.failBound_summable
  failBudget_le_failBound := h.failBudget_le_failBound
  endpoints_in_block := h.endpoints_in_block
  countMean_le_beta_sum := h.countMean_le_beta_sum
  pairBudget_le_countRawSecond := h.pairBudget_le_countRawSecond
  beta_le_tail_prob := by
    intro j r hr
    let cert : EndpointSeparationFiniteFreshWalkZeroRemainderCertificate := {
      X := fun N omega => normSum omega N
      lambda := h.lambda j r
      M := h.M j
      T := h.T j r
      U := h.U j r
      a := h.a j r
      b := h.b j r
      A := h.A j r
      freshSet := h.freshSet j r
      coeff := h.coeff j r
      variance_pos := h.variance_pos j r hr
      decomp := h.decomp j r hr
      separation_threshold := h.separation_threshold j r hr
      endpoint_screen := h.endpoint_screen j r hr
      background_invariant := h.background_invariant j r hr
      fresh_threshold_sq := h.fresh_threshold_sq j r hr }
    calc
      h.beta j
          ≤ (1 : ℝ) / 24 := h.beta_le_one_over_twenty_four j r hr
      _ ≤
          mu.real
            (endpointAbsPairSuccessEvent
              (fun N omega => normSum omega N) (h.M j) (h.a j r) (h.b j r)) :=
            by simpa [cert] using cert.measureReal_endpointAbsPairSuccess_lower
  tail_prob_le_tailUpper := h.tail_prob_le_tailUpper
  offdiag_pair_prob_le_pairUpper := h.offdiag_pair_prob_le_pairUpper

/-- Exact finite fresh-walk uniform real-budget certificates produce the
all-absolute-screens failure certificate. -/
noncomputable def
    endpointSeparationAbsScreenCertificate_of_finiteFreshWalkZeroRemainderUniformRealBudget
    (h :
      EndpointSeparationAbsScreenUniformFiniteFreshWalkZeroRemainderRealBudgetCertificate) :
    EndpointSeparationAbsScreenCertificate :=
  endpointSeparationAbsScreenCertificate_of_uniformRealBudget
    (endpointSeparationAbsScreenUniformRealBudgetCertificate_of_finiteFreshWalkZeroRemainder h)

/-- Direct closure of the absolute target from exact finite fresh-walk uniform
screen estimates. -/
theorem absErdos1144_of_finiteFreshWalkZeroRemainderUniformRealBudget
    (h :
      EndpointSeparationAbsScreenUniformFiniteFreshWalkZeroRemainderRealBudgetCertificate) :
    AbsErdos1144 :=
  absErdos1144_of_endpointSeparationAbsScreenCertificate
    (endpointSeparationAbsScreenCertificate_of_finiteFreshWalkZeroRemainderUniformRealBudget h)

/-- Absolute pierced-screen certificate.  This is the natural real-probability
form of the Harperized many-trial analytic theorem: with probability at least
`1 - fail j`, some absolute endpoint-pair screen is pierced. -/
structure EndpointSeparationAbsPiercedScreenCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  fail : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  fail_summable : (∑' j, ENNReal.ofReal (fail j)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  prob_some_pair_success :
    ∀ j,
      1 - fail j ≤
        mu.real
          {omega |
            ∃ r, r ∈ indexSet j ∧
              omega ∈
                endpointAbsPairSuccessEvent
                  (fun N omega => normSum omega N) (M j) (a j r) (b j r)}

/-- Convert an absolute pierced-screen certificate to the existing
all-screens-fail certificate. -/
noncomputable def endpointSeparationAbsScreenCertificate_of_pierced
    (h : EndpointSeparationAbsPiercedScreenCertificate) :
    EndpointSeparationAbsScreenCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  fail := fun j => ENNReal.ofReal (h.fail j)
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  prob_screen_failure := by
    intro j
    exact
      measure_endpointAbsScreenFailureEvent_le_of_exists_pairSuccess_measureReal
        h.indexSet h.a h.b h.M j (h.fail j) (h.prob_some_pair_success j)

/-- Direct closure of the absolute target from a pierced-screen certificate. -/
theorem absErdos1144_of_endpointSeparationAbsPiercedScreenCertificate
    (h : EndpointSeparationAbsPiercedScreenCertificate) :
    AbsErdos1144 :=
  absErdos1144_of_endpointSeparationAbsScreenCertificate
    (endpointSeparationAbsScreenCertificate_of_pierced h)

