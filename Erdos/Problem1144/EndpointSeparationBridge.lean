theorem measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_of_freshSignFlip
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A R : Omega → ℝ) (s : Finset ℕ) (coeff : ℕ → ℝ) (second : ℝ)
