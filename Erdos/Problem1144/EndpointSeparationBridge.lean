  prob_screen_failure := by
    intro j
    exact
      measure_endpointPositiveScreenFailureEvent_le_count_second
        h.indexSet h.a h.b h.M j (h.countMean j) (h.countSecond j)
        (h.countMean_pos j) (h.count_centered_second_integrable j)
        (h.count_mean_lower j) (h.count_centered_second_upper j)

