    Erdos1144 :=
  erdos1144_of_endpointSeparationDirectPositiveScreenCertificate
    (endpointSeparationDirectPositiveScreenCertificate_of_uniformRealBudget h)

/-- Cardinality-budget positive endpoint-screen probability estimates produce
the direct all-positive-screens-fail certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenCertificate_of_cardinalityTailProbability
    (h : EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate) :
    EndpointSeparationDirectPositiveScreenCertificate :=
  endpointSeparationDirectPositiveScreenCertificate_of_uniformTailProbability
    (endpointSeparationDirectPositiveScreenUniformTailProbabilityCertificate_of_cardinality h)

/-- Direct final handoff from cardinality-budget positive endpoint-screen
probability estimates. -/
theorem erdos1144_of_endpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate
    (h : EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate) :
