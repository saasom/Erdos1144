/-- Final one-sided handoff from absolute unboundedness when the positive
zero-one law and sign symmetry are both supplied as set-level probability
statements. -/
theorem erdos1144_of_absErdos1144_of_measureZeroOneMeasureSymmetry
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hsym : PositiveNegativeMeasureSymmetry) :
    Erdos1144 :=
  erdos1144_of_absToPositiveSignAdapter
    (absToPositiveSignAdapter_of_measureZeroOneMeasureSymmetry habs hzero hsym)

/-- A block contains an endpoint whose normalized sum is large in absolute
value. -/
def absBlockSuccess (X Y : ℕ → ℕ) (M : ℕ → ℝ) (omega : Omega) (j : ℕ) :
    Prop :=
  ∃ N ∈ Finset.Icc (X j) (Y j), M j ≤ |normSum omega N|

/-- Failure of the absolute block event. -/
def absBlockFailure (X Y : ℕ → ℕ) (M : ℕ → ℝ) (j : ℕ) : Set Omega :=
  {omega | ¬ absBlockSuccess X Y M omega j}

/-- Checkable absolute-block certificate. -/
structure AbsBlockOmega where
  X : ℕ → ℕ
  Y : ℕ → ℕ
  M : ℕ → ℝ
  fail : ℕ → ℝ≥0∞
  X_tendsto : Tendsto X atTop atTop
  M_tendsto : Tendsto M atTop atTop
  fail_summable : (∑' j, fail j) ≠ ⊤
  prob_fail :
    ∀ j, mu (absBlockFailure X Y M j) ≤ fail j

/-- Absolute block certificates imply absolute unboundedness of `normSum`. -/
theorem absErdos1144_of_absBlockOmega
    (h : AbsBlockOmega) :
    AbsErdos1144 := by
  let F : ℕ → Set Omega := absBlockFailure h.X h.Y h.M
  have htsum : (∑' j, mu (F j)) ≠ ⊤ := by
    exact ne_top_of_le_ne_top h.fail_summable (ENNReal.tsum_le_tsum h.prob_fail)
  have hbc : mu (limsup F atTop) = 0 :=
    MeasureTheory.measure_limsup_atTop_eq_zero (μ := mu) (s := F) htsum
  have hnotlimsup : ∀ᵐ omega ∂mu, omega ∉ limsup F atTop := by
    rw [MeasureTheory.ae_iff]
    simpa using hbc
  filter_upwards [hnotlimsup] with omega homega A
  have hsucc_eventually :
      ∀ᶠ j : ℕ in atTop, absBlockSuccess h.X h.Y h.M omega j := by
    rw [Filter.mem_limsup_iff_frequently_mem] at homega
    simpa [F, absBlockFailure, Filter.Frequently] using homega
  rw [Filter.Frequently]
  intro hbad
  rw [eventually_atTop] at hbad
  rcases hbad with ⟨N0, hN0⟩
  have hMev : ∀ᶠ j : ℕ in atTop, A ≤ h.M j :=
    h.M_tendsto.eventually_ge_atTop A
  have hXev : ∀ᶠ j : ℕ in atTop, N0 ≤ h.X j :=
    h.X_tendsto.eventually_ge_atTop N0
  rcases (hsucc_eventually.and (hMev.and hXev)).exists with
    ⟨j, hsucc, hMj, hXj⟩
  rcases hsucc with ⟨N, hNmem, hMle⟩
  have hXleN : h.X j ≤ N := (Finset.mem_Icc.mp hNmem).1
  exact hN0 N (le_trans hXj hXleN) (le_trans hMj hMle)

/-- Raw endpoint separation `X_b - lambda * X_a`. -/
def endpointSeparationValue
    (X : ℕ → Omega → ℝ) (lambda : ℝ) (a b : ℕ) (omega : Omega) : ℝ :=
  X b omega - lambda * X a omega

/-- The raw endpoint separation is large in absolute value. -/
def endpointSeparationLargeEvent
    (X : ℕ → Omega → ℝ) (lambda : ℝ) (a b : ℕ) (T : ℝ) : Set Omega :=
  {omega | T ≤ |endpointSeparationValue X lambda a b omega|}

/-- At least one of two raw endpoints is large in absolute value. -/
def endpointAbsPairSuccessEvent
    (X : ℕ → Omega → ℝ) (M : ℝ) (a b : ℕ) : Set Omega :=
  {omega | M ≤ |X a omega| ∨ M ≤ |X b omega|}

/-- Measurability of the raw absolute endpoint-pair event. -/
theorem measurableSet_endpointAbsPairSuccessEvent
    (M : ℝ) (a b : ℕ) :
    MeasurableSet
      (endpointAbsPairSuccessEvent (fun N omega => normSum omega N) M a b) := by
  have ha : MeasurableSet {omega : Omega | M ≤ |normSum omega a|} :=
    measurableSet_le measurable_const
      (continuous_abs.measurable.comp (measurable_normSum a))
  have hb : MeasurableSet {omega : Omega | M ≤ |normSum omega b|} :=
    measurableSet_le measurable_const
      (continuous_abs.measurable.comp (measurable_normSum b))
  exact ha.union hb

/-- A large endpoint separation forces one endpoint to be large in absolute
value. -/
theorem endpointSeparationLarge_subset_endpointAbsPairSuccess
    (X : ℕ → Omega → ℝ) (lambda M T : ℝ) (a b : ℕ)
    (hT : (1 + |lambda|) * M < T) :
    endpointSeparationLargeEvent X lambda a b T ⊆
      endpointAbsPairSuccessEvent X M a b := by
  intro omega hsep
  by_contra hnot
  rw [endpointAbsPairSuccessEvent, Set.mem_setOf_eq, not_or] at hnot
  rcases hnot with ⟨ha_not, hb_not⟩
  have ha_lt : |X a omega| < M := lt_of_not_ge ha_not
  have hb_lt : |X b omega| < M := lt_of_not_ge hb_not
  have hsep_bound :
      |endpointSeparationValue X lambda a b omega| <
        (1 + |lambda|) * M := by
    calc
      |endpointSeparationValue X lambda a b omega|
          = |X b omega - lambda * X a omega| := rfl
      _ ≤ |X b omega| + |lambda * X a omega| := abs_sub _ _
      _ = |X b omega| + |lambda| * |X a omega| := by rw [abs_mul]
      _ < M + |lambda| * M := by
            exact add_lt_add_of_lt_of_le hb_lt
              (mul_le_mul_of_nonneg_left (le_of_lt ha_lt) (abs_nonneg lambda))
      _ = (1 + |lambda|) * M := by ring
  change T ≤ |endpointSeparationValue X lambda a b omega| at hsep
  linarith

/-- Fresh part before the final small remainder, `A + Z`, is large. -/
def shiftedFreshLargeEvent (A Z : Omega → ℝ) (U : ℝ) : Set Omega :=
  {omega | U ≤ |A omega + Z omega|}

/-- The reflected shifted fresh part, `A - Z`, is large. -/
def shiftedFreshReflectedLargeEvent (A Z : Omega → ℝ) (U : ℝ) : Set Omega :=
  {omega | U ≤ |A omega - Z omega|}

/-- The genuinely fresh part is large. -/
def freshLargeEvent (Z : Omega → ℝ) (U : ℝ) : Set Omega :=
  {omega | U ≤ |Z omega|}

/-- A fourth-moment lower bound for the fresh-large event.  If the fresh
variable has second moment at least `V` and fourth moment at most `K * V^2`,
then it exceeds any threshold with `U^2 <= V/2` with probability at least
`1 / (4K)`.  For the standard Rademacher fourth-moment bound `K = 3`, this is
the `1/12` lower bound used in the endpoint-separation argument. -/
theorem measureReal_freshLargeEvent_lower_of_second_fourth
    (Z : Omega → ℝ) (U V K : ℝ)
    (hZ : Measurable Z)
    (hV : 0 < V)
    (hK : 0 < K)
    (hU_sq : U ^ 2 ≤ V / 2)
    (hsecond_int : Integrable (fun omega => (Z omega) ^ 2) mu)
    (hfourth_int : Integrable (fun omega => (Z omega) ^ 4) mu)
    (hsecond : V ≤ ∫ omega, (Z omega) ^ 2 ∂mu)
    (hfourth : (∫ omega, (Z omega) ^ 4 ∂mu) ≤ K * V ^ 2) :
    1 / (4 * K) ≤ mu.real (freshLargeEvent Z U) := by
  let E := freshLargeEvent Z U
  let Y : Omega → ℝ := fun omega => (Z omega) ^ 2
  let Q : Omega → ℝ := fun omega => (Z omega) ^ 4
  have hE : MeasurableSet E := by
    exact measurableSet_le measurable_const (continuous_abs.measurable.comp hZ)
  have hY_int : Integrable Y mu := hsecond_int
  have hQ_int : Integrable Q mu := hfourth_int
  have hEY_int : Integrable (fun omega => E.indicator Y omega) mu :=
    hY_int.indicator hE
  have hprob_univ : mu.real Set.univ = 1 := by
    rw [measureReal_def, measure_univ]
    norm_num
  have hY_upper_point :
      ∀ omega, Y omega ≤ V / 2 + E.indicator Y omega := by
    intro omega
    by_cases homega : omega ∈ E
    · rw [Set.indicator_of_mem homega]
      linarith [show 0 ≤ V / 2 by positivity]
    · have hlt : |Z omega| < U := lt_of_not_ge homega
      have habs_le : |Z omega| ≤ U := le_of_lt hlt
      have hsquare_abs : |Z omega| ^ 2 ≤ U ^ 2 :=
        pow_le_pow_left₀ (abs_nonneg (Z omega)) habs_le 2
      have hY_le_U : Y omega ≤ U ^ 2 := by
        rw [← abs_pow] at hsquare_abs
        simpa [Y, abs_of_nonneg (sq_nonneg (Z omega))] using hsquare_abs
      have hY_le_V : Y omega ≤ V / 2 := hY_le_U.trans hU_sq
      simpa [E, Y, homega] using hY_le_V
  have hY_integral_upper :
      (∫ omega, Y omega ∂mu) ≤
        ∫ omega, (V / 2 + E.indicator Y omega) ∂mu := by
    exact
      integral_mono hY_int ((integrable_const (V / 2)).add hEY_int)
        hY_upper_point
  have hEY_lower : V / 2 ≤ ∫ omega, E.indicator Y omega ∂mu := by
    have hupper :
        (∫ omega, Y omega ∂mu) ≤
          V / 2 + ∫ omega, E.indicator Y omega ∂mu := by
      calc
        (∫ omega, Y omega ∂mu)
            ≤ ∫ omega, (V / 2 + E.indicator Y omega) ∂mu := hY_integral_upper
        _ = V / 2 + ∫ omega, E.indicator Y omega ∂mu := by
              rw [integral_add (integrable_const (V / 2)) hEY_int]
              simp [integral_const, hprob_univ]
    linarith
  have hden_pos : 0 < 4 * K * V := by positivity
  have hKV_pos : 0 < K * V := by positivity
  let Rhs : Omega → ℝ :=
    fun omega => Q omega / (4 * K * V) +
      (K * V) * E.indicator (fun _ : Omega => (1 : ℝ)) omega
  have hRhs_int : Integrable Rhs mu := by
    refine (hQ_int.div_const (4 * K * V)).add ?_
    exact ((integrable_const (1 : ℝ)).indicator hE).const_mul (K * V)
  have hYoung_point : ∀ omega, E.indicator Y omega ≤ Rhs omega := by
    intro omega
    by_cases homega : omega ∈ E
    · have hq_eq : Q omega = (Y omega) ^ 2 := by
        simp [Q, Y]
        ring
      have hyoung : Y omega ≤ Q omega / (4 * K * V) + K * V := by
        rw [hq_eq]
        field_simp [hden_pos.ne']
        nlinarith [sq_nonneg (Y omega - 2 * K * V)]
      simpa [Rhs, Y, homega] using hyoung
    · have hnonneg : 0 ≤ Q omega / (4 * K * V) := by
        exact div_nonneg (by positivity) hden_pos.le
      simp [Rhs, Y, homega, hnonneg]
  have hEY_upper :
      (∫ omega, E.indicator Y omega ∂mu) ≤
        V / 4 + K * V * mu.real E := by
    have hmono :
        (∫ omega, E.indicator Y omega ∂mu) ≤ ∫ omega, Rhs omega ∂mu :=
      integral_mono hEY_int hRhs_int hYoung_point
    have hRhs_eval :
        (∫ omega, Rhs omega ∂mu) =
          (∫ omega, Q omega ∂mu) / (4 * K * V) + K * V * mu.real E := by
      have hIndOne :
          (∫ omega, E.indicator (fun _ : Omega => (1 : ℝ)) omega ∂mu) =
            mu.real E := by
        simpa using MeasureTheory.integral_indicator_one (μ := mu) hE
      rw [show (∫ omega, Rhs omega ∂mu) =
          (∫ omega, Q omega / (4 * K * V) ∂mu) +
            ∫ omega,
              (K * V) * E.indicator (fun _ : Omega => (1 : ℝ)) omega ∂mu by
            rw [integral_add (hQ_int.div_const (4 * K * V))
              (((integrable_const (1 : ℝ)).indicator hE).const_mul (K * V))]]
      rw [integral_div]
      rw [integral_const_mul]
      rw [hIndOne]
    calc
      (∫ omega, E.indicator Y omega ∂mu)
          ≤ ∫ omega, Rhs omega ∂mu := hmono
      _ = (∫ omega, Q omega ∂mu) / (4 * K * V) + K * V * mu.real E :=
          hRhs_eval
      _ ≤ (K * V ^ 2) / (4 * K * V) + K * V * mu.real E := by
          have hfourthQ : (∫ omega, Q omega ∂mu) ≤ K * V ^ 2 := by
            simpa [Q] using hfourth
          have hdivle :
              (∫ omega, Q omega ∂mu) / (4 * K * V) ≤
                (K * V ^ 2) / (4 * K * V) :=
            div_le_div_of_nonneg_right hfourthQ hden_pos.le
          simpa [add_comm, add_left_comm, add_assoc] using
            add_le_add_left hdivle (K * V * mu.real E)
      _ = V / 4 + K * V * mu.real E := by
          field_simp [hK.ne', hV.ne']
  have hmain : V / 2 ≤ V / 4 + K * V * mu.real E :=
    hEY_lower.trans hEY_upper
  have hmul : V / 4 ≤ K * V * mu.real E := by linarith
  have hdiv : V / 4 / (K * V) ≤ mu.real E := by
    have hmul' : V / 4 ≤ mu.real E * (K * V) := by
      rwa [mul_comm] at hmul
    exact (div_le_iff₀ hKV_pos).2 hmul'
  calc
    1 / (4 * K) = V / 4 / (K * V) := by
      field_simp [hK.ne', hV.ne']
    _ ≤ mu.real E := hdiv

/-- Fresh-large lower bound specialized to a finite weighted Rademacher
linear form.  The finite-walk variance and fourth-moment inputs are supplied
by `RademacherConcentration`, so the analytic side only needs to prove the
threshold is below the natural `sqrt(V/2)` scale. -/
theorem measureReal_freshLargeEvent_lower_epsLinearForm
    (s : Finset ℕ) (a : ℕ → ℝ) (U : ℝ)
    (hV : 0 < ∑ p ∈ s, a p ^ 2)
    (hU_sq : U ^ 2 ≤ (∑ p ∈ s, a p ^ 2) / 2) :
    (1 : ℝ) / 12 ≤ mu.real (freshLargeEvent (epsLinearForm s a) U) := by
  have hlower :=
    measureReal_freshLargeEvent_lower_of_second_fourth
      (epsLinearForm s a) U (∑ p ∈ s, a p ^ 2) 3
      (measurable_epsLinearForm s a)
      hV
      (by norm_num : (0 : ℝ) < 3)
      hU_sq
      (integrable_epsLinearForm_sq s a)
      (integrable_epsLinearForm_fourth s a)
      (by rw [integral_epsLinearForm_sq_eq_sum_sq])
      (integral_epsLinearForm_fourth_le_three_sum_sq_sq s a)
  norm_num at hlower ⊢
  exact hlower

/-- The small-remainder event. -/
def remainderSmallEvent (R : Omega → ℝ) (eps : ℝ) : Set Omega :=
  {omega | |R omega| ≤ eps}

/-- The deterministic fact that a shift cannot hide both signs of a large fresh
fluctuation. -/
theorem freshLarge_subset_shiftedFresh_or_reflected
    (A Z : Omega → ℝ) (U : ℝ) :
    freshLargeEvent Z U ⊆
      shiftedFreshLargeEvent A Z U ∪ shiftedFreshReflectedLargeEvent A Z U := by
  intro omega hfresh
  by_contra hnot
  rw [Set.mem_union, not_or] at hnot
  rcases hnot with ⟨hnotPlus, hnotMinus⟩
  change ¬ U ≤ |A omega + Z omega| at hnotPlus
  change ¬ U ≤ |A omega - Z omega| at hnotMinus
  have hplus_lt : |A omega + Z omega| < U := lt_of_not_ge hnotPlus
  have hminus_lt : |A omega - Z omega| < U := lt_of_not_ge hnotMinus
  have hdiff_le :
      |(A omega + Z omega) - (A omega - Z omega)| ≤
        |A omega + Z omega| + |A omega - Z omega| :=
    abs_sub _ _
  have hdiff_eq :
      |(A omega + Z omega) - (A omega - Z omega)| = 2 * |Z omega| := by
    rw [show (A omega + Z omega) - (A omega - Z omega) = 2 * Z omega by ring]
    simp [abs_mul]
  have htwo_lt : 2 * |Z omega| < 2 * U := by
    rw [hdiff_eq] at hdiff_le
    linarith
  have hz_lt : |Z omega| < U := by
    nlinarith
  change U ≤ |Z omega| at hfresh
  linarith

/-- Probability form of the shift-cannot-hide lemma.  The equality assumption
is the conditional/law-symmetry input that `A + Z` and `A - Z` have the same
probability for this large-deviation event. -/
theorem measureReal_shiftedFreshLarge_lower_of_freshLarge
    (A Z : Omega → ℝ) (U p : ℝ)
    (hreflect :
      mu.real (shiftedFreshLargeEvent A Z U) =
        mu.real (shiftedFreshReflectedLargeEvent A Z U))
    (hfresh : p ≤ mu.real (freshLargeEvent Z U)) :
    p / 2 ≤ mu.real (shiftedFreshLargeEvent A Z U) := by
  let F := freshLargeEvent Z U
  let P := shiftedFreshLargeEvent A Z U
  let R := shiftedFreshReflectedLargeEvent A Z U
  have hsubset : F ⊆ P ∪ R :=
    freshLarge_subset_shiftedFresh_or_reflected A Z U
  have hF_le : mu.real F ≤ mu.real P + mu.real R := by
    calc
      mu.real F ≤ mu.real (P ∪ R) := measureReal_mono hsubset
      _ ≤ mu.real P + mu.real R := measureReal_union_le P R
  have hF_le_two : mu.real F ≤ 2 * mu.real P := by
    linarith
  linarith

/-- A measure-preserving fresh-sign reflection gives the probability equality
between `A + Z` and `A - Z` large-deviation events.  No measurability of the
events is required: `measure_preimage_le` gives both inequalities. -/
theorem measureReal_shiftedFreshLarge_eq_reflected_of_measurePreserving
    (A Z : Omega → ℝ) (U : ℝ) (tau : Omega → Omega)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZ : ∀ omega, Z (tau omega) = -Z omega) :
    mu.real (shiftedFreshLargeEvent A Z U) =
      mu.real (shiftedFreshReflectedLargeEvent A Z U) := by
  let P := shiftedFreshLargeEvent A Z U
  let R := shiftedFreshReflectedLargeEvent A Z U
  have hpreP : tau ⁻¹' P = R := by
    ext omega
    simp [P, R, shiftedFreshLargeEvent, shiftedFreshReflectedLargeEvent,
      hA omega, hZ omega, sub_eq_add_neg]
  have hpreR : tau ⁻¹' R = P := by
    ext omega
    simp [P, R, shiftedFreshLargeEvent, shiftedFreshReflectedLargeEvent,
      hA omega, hZ omega, sub_eq_add_neg]
  have hR_le_P : mu R ≤ mu P := by
    calc
      mu R = mu (tau ⁻¹' P) := by rw [hpreP]
      _ ≤ mu P := htau.measure_preimage_le P
  have hP_le_R : mu P ≤ mu R := by
    calc
      mu P = mu (tau ⁻¹' R) := by rw [hpreR]
      _ ≤ mu R := htau.measure_preimage_le R
  have hmeasure : mu P = mu R := le_antisymm hP_le_R hR_le_P
  simp [P, R, measureReal_def, hmeasure]

/-- Probability form of the shift-cannot-hide lemma, with reflection supplied
by a measure-preserving fresh-sign flip. -/
theorem measureReal_shiftedFreshLarge_lower_of_freshLarge_of_measurePreserving
    (A Z : Omega → ℝ) (U p : ℝ) (tau : Omega → Omega)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZ : ∀ omega, Z (tau omega) = -Z omega)
    (hfresh : p ≤ mu.real (freshLargeEvent Z U)) :
    p / 2 ≤ mu.real (shiftedFreshLargeEvent A Z U) :=
  measureReal_shiftedFreshLarge_lower_of_freshLarge A Z U p
    (measureReal_shiftedFreshLarge_eq_reflected_of_measurePreserving
      A Z U tau htau hA hZ)
    hfresh

/-- A large shifted fresh part and a small final remainder force a large raw
endpoint separation. -/
theorem shiftedFreshLarge_inter_remainderSmall_subset_separationLarge
    (D A Z R : Omega → ℝ) (U eps T : ℝ)
    (hdecomp : ∀ omega, D omega = A omega + Z omega + R omega)
    (hT : T ≤ U - eps) :
    shiftedFreshLargeEvent A Z U ∩ remainderSmallEvent R eps ⊆
      {omega | T ≤ |D omega|} := by
  intro omega homega
  rcases homega with ⟨hfresh, hrem⟩
  change U ≤ |A omega + Z omega| at hfresh
  change |R omega| ≤ eps at hrem
  have htri : |A omega + Z omega| ≤ |D omega| + |R omega| := by
    have hAZ : A omega + Z omega = D omega - R omega := by
      rw [hdecomp omega]
      ring
    rw [hAZ]
    simpa [sub_eq_add_neg, abs_neg] using abs_add_le (D omega) (-(R omega))
  change T ≤ |D omega|
  linarith

/-- Endpoint-separation bridge from a shifted fresh fluctuation plus small
remainder to a raw absolute endpoint success. -/
theorem shiftedFreshLarge_inter_remainderSmall_subset_endpointAbsPairSuccess
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A Z R : Omega → ℝ)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T) :
    shiftedFreshLargeEvent A Z U ∩ remainderSmallEvent R eps ⊆
      endpointAbsPairSuccessEvent X M a b := by
  intro omega homega
  exact
    endpointSeparationLarge_subset_endpointAbsPairSuccess X lambda M T a b hM
      ((shiftedFreshLarge_inter_remainderSmall_subset_separationLarge
          (fun omega => endpointSeparationValue X lambda a b omega)
          A Z R U eps T hdecomp hT)
        homega)

/-- Generic real-measure lower bound from `E ∩ G ⊆ S`: an event with
probability at least `p`, after removing a bad complement of probability at
most `q`, gives `S` probability at least `p - q`. -/
theorem measureReal_lower_of_inter_good_subset
    (E G S : Set Omega) (p q : ℝ)
    (hsubset : E ∩ G ⊆ S)
    (hE : p ≤ mu.real E)
    (hbad : mu.real Gᶜ ≤ q) :
    p - q ≤ mu.real S := by
  have hcover : E ⊆ S ∪ Gᶜ := by
    intro omega homega
    by_cases hG : omega ∈ G
    · exact Or.inl (hsubset ⟨homega, hG⟩)
    · exact Or.inr hG
  have hE_le : mu.real E ≤ mu.real S + mu.real Gᶜ := by
    calc
      mu.real E ≤ mu.real (S ∪ Gᶜ) := measureReal_mono hcover
      _ ≤ mu.real S + mu.real Gᶜ := measureReal_union_le S Gᶜ
  linarith

/-- On a probability space, a real lower bound for an event gives an `ENNReal`
upper bound for its complement. -/
theorem measure_compl_le_of_measureReal_ge_one_sub
    (S : Set Omega) (delta : ℝ)
    (hS : MeasurableSet S)
    (hlower : 1 - delta ≤ mu.real S) :
    mu Sᶜ ≤ ENNReal.ofReal delta := by
  have hreal : mu.real Sᶜ ≤ delta := by
    have hsum := probReal_add_probReal_compl (μ := mu) hS
    linarith
  rw [← ENNReal.ofReal_toReal (measure_ne_top mu Sᶜ)]
  exact ENNReal.ofReal_le_ofReal hreal

/-- Probability lower bound for endpoint absolute success from fresh
large-deviation probability, reflection symmetry, and a small-remainder
exceptional-probability bound. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_freshLarge
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A Z R : Omega → ℝ) (p q : ℝ)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T)
    (hreflect :
      mu.real (shiftedFreshLargeEvent A Z U) =
        mu.real (shiftedFreshReflectedLargeEvent A Z U))
    (hfresh : p ≤ mu.real (freshLargeEvent Z U))
    (hbad : mu.real (remainderSmallEvent R eps)ᶜ ≤ q) :
    p / 2 - q ≤ mu.real (endpointAbsPairSuccessEvent X M a b) := by
  have hshift :
      p / 2 ≤ mu.real (shiftedFreshLargeEvent A Z U) :=
    measureReal_shiftedFreshLarge_lower_of_freshLarge A Z U p hreflect hfresh
  exact
    measureReal_lower_of_inter_good_subset
      (shiftedFreshLargeEvent A Z U)
      (remainderSmallEvent R eps)
      (endpointAbsPairSuccessEvent X M a b)
      (p / 2) q
      (shiftedFreshLarge_inter_remainderSmall_subset_endpointAbsPairSuccess
        X lambda M T U eps a b A Z R hdecomp hT hM)
      hshift hbad

/-- Endpoint absolute-success lower bound with reflection supplied by a
measure-preserving fresh-sign flip. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_freshLarge_of_measurePreserving
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A Z R : Omega → ℝ) (p q : ℝ) (tau : Omega → Omega)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZ : ∀ omega, Z (tau omega) = -Z omega)
    (hfresh : p ≤ mu.real (freshLargeEvent Z U))
    (hbad : mu.real (remainderSmallEvent R eps)ᶜ ≤ q) :
    p / 2 - q ≤ mu.real (endpointAbsPairSuccessEvent X M a b) :=
  measureReal_endpointAbsPairSuccess_lower_of_freshLarge X lambda M T U eps a b
    A Z R p q hdecomp hT hM
    (measureReal_shiftedFreshLarge_eq_reflected_of_measurePreserving
      A Z U tau htau hA hZ)
    hfresh hbad

/-- Real-valued Markov bound for an absolute error event. -/
theorem measureReal_abs_error_gt_le_second
    (E : Omega → ℝ) (A V : ℝ)
    (hA : 0 < A)
    (hint : Integrable (fun omega => (E omega) ^ 2) mu)
    (hsecond : (∫ omega, (E omega) ^ 2 ∂mu) ≤ V) :
    mu.real {omega | A < |E omega|} ≤ V / A ^ 2 := by
  let T : Set Omega := {omega | A ^ 2 ≤ (E omega) ^ 2}
  have hsubset : {omega | A < |E omega|} ⊆ T := by
    intro omega hlt
    have hAle : A ≤ |E omega| := le_of_lt hlt
    have hsquare : A ^ 2 ≤ |E omega| ^ 2 :=
      pow_le_pow_left₀ hA.le hAle 2
    rw [← abs_pow] at hsquare
    simpa [T, abs_of_nonneg (by positivity : 0 ≤ (E omega) ^ 2)] using hsquare
  have hnonneg : 0 ≤ᵐ[mu] fun omega => (E omega) ^ 2 :=
    ae_of_all _ fun omega => by positivity
  have hmarkov :=
    mul_meas_ge_le_integral_of_nonneg (μ := mu)
      (f := fun omega => (E omega) ^ 2)
      hnonneg hint (A ^ 2)
  have hTreal : mu.real T ≤ V / A ^ 2 := by
    have hmul : A ^ 2 * mu.real T ≤ V :=
      le_trans hmarkov hsecond
    rw [le_div_iff₀ (pow_pos hA 2)]
    simpa [mul_comm] using hmul
  exact (measureReal_mono hsubset).trans hTreal

/-- Real-valued second-moment control for the complement of
`remainderSmallEvent`. -/
theorem measureReal_remainderSmall_compl_le_second
    (R : Omega → ℝ) (eps second : ℝ)
    (heps : 0 < eps)
    (hint : Integrable (fun omega => (R omega) ^ 2) mu)
    (hsecond : (∫ omega, (R omega) ^ 2 ∂mu) ≤ second) :
    mu.real (remainderSmallEvent R eps)ᶜ ≤ second / eps ^ 2 := by
  have hsubset :
      (remainderSmallEvent R eps)ᶜ ⊆ {omega | eps < |R omega|} := by
    intro omega hnot
    change ¬ |R omega| ≤ eps at hnot
    exact lt_of_not_ge hnot
  calc
    mu.real (remainderSmallEvent R eps)ᶜ
        ≤ mu.real {omega | eps < |R omega|} :=
          measureReal_mono hsubset
    _ ≤ second / eps ^ 2 :=
          measureReal_abs_error_gt_le_second R eps second heps hint hsecond

/-- Endpoint absolute-success lower bound directly from fresh second/fourth
moment control and an `L^2` small-remainder budget.  With the standard
Rademacher fourth-moment constant `K = 3`, the fresh term contributes
`1 / 24` before paying the remainder budget. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_second_fourth
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A Z R : Omega → ℝ) (V K second : ℝ)
    (hZ : Measurable Z)
    (hV : 0 < V)
    (hK : 0 < K)
    (heps : 0 < eps)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T)
    (hreflect :
      mu.real (shiftedFreshLargeEvent A Z U) =
        mu.real (shiftedFreshReflectedLargeEvent A Z U))
    (hU_sq : U ^ 2 ≤ V / 2)
    (hZsecond_int : Integrable (fun omega => (Z omega) ^ 2) mu)
    (hZfourth_int : Integrable (fun omega => (Z omega) ^ 4) mu)
    (hZsecond : V ≤ ∫ omega, (Z omega) ^ 2 ∂mu)
    (hZfourth : (∫ omega, (Z omega) ^ 4 ∂mu) ≤ K * V ^ 2)
    (hRsecond_int : Integrable (fun omega => (R omega) ^ 2) mu)
    (hRsecond : (∫ omega, (R omega) ^ 2 ∂mu) ≤ second) :
    1 / (8 * K) - second / eps ^ 2 ≤
      mu.real (endpointAbsPairSuccessEvent X M a b) := by
  have hfresh :
      1 / (4 * K) ≤ mu.real (freshLargeEvent Z U) :=
    measureReal_freshLargeEvent_lower_of_second_fourth Z U V K hZ hV hK
      hU_sq hZsecond_int hZfourth_int hZsecond hZfourth
  have hbad :
      mu.real (remainderSmallEvent R eps)ᶜ ≤ second / eps ^ 2 :=
    measureReal_remainderSmall_compl_le_second R eps second heps
      hRsecond_int hRsecond
  have hlower :
      (1 / (4 * K)) / 2 - second / eps ^ 2 ≤
        mu.real (endpointAbsPairSuccessEvent X M a b) :=
    measureReal_endpointAbsPairSuccess_lower_of_freshLarge X lambda M T U eps a b
      A Z R (1 / (4 * K)) (second / eps ^ 2)
      hdecomp hT hM hreflect hfresh hbad
  have hconst : (1 / (4 * K)) / 2 = 1 / (8 * K) := by
    field_simp [hK.ne']
    ring
  rwa [hconst] at hlower

/-- Endpoint absolute-success lower bound from second/fourth moments and an
`L^2` remainder budget, with reflection supplied by a measure-preserving
fresh-sign flip. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_second_fourth_of_measurePreserving
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A Z R : Omega → ℝ) (V K second : ℝ) (tau : Omega → Omega)
    (hZmeas : Measurable Z)
    (hV : 0 < V)
    (hK : 0 < K)
    (heps : 0 < eps)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZflip : ∀ omega, Z (tau omega) = -Z omega)
    (hU_sq : U ^ 2 ≤ V / 2)
    (hZsecond_int : Integrable (fun omega => (Z omega) ^ 2) mu)
    (hZfourth_int : Integrable (fun omega => (Z omega) ^ 4) mu)
    (hZsecond : V ≤ ∫ omega, (Z omega) ^ 2 ∂mu)
    (hZfourth : (∫ omega, (Z omega) ^ 4 ∂mu) ≤ K * V ^ 2)
    (hRsecond_int : Integrable (fun omega => (R omega) ^ 2) mu)
    (hRsecond : (∫ omega, (R omega) ^ 2 ∂mu) ≤ second) :
    1 / (8 * K) - second / eps ^ 2 ≤
      mu.real (endpointAbsPairSuccessEvent X M a b) := by
  exact
    measureReal_endpointAbsPairSuccess_lower_of_second_fourth
      X lambda M T U eps a b A Z R V K second hZmeas hV hK heps hdecomp hT hM
      (measureReal_shiftedFreshLarge_eq_reflected_of_measurePreserving
        A Z U tau htau hA hZflip)
      hU_sq hZsecond_int hZfourth_int hZsecond hZfourth hRsecond_int hRsecond

/-- Exact-increment specialization of
`measureReal_endpointAbsPairSuccess_lower_of_second_fourth`: if the endpoint
separation is exactly `A + Z`, no small-remainder budget is needed. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_second_fourth_zero_remainder
    (X : ℕ → Omega → ℝ) (lambda M T U : ℝ) (a b : ℕ)
    (A Z : Omega → ℝ) (V K : ℝ)
    (hZ : Measurable Z)
    (hV : 0 < V)
    (hK : 0 < K)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega)
    (hT : T ≤ U)
    (hM : (1 + |lambda|) * M < T)
    (hreflect :
      mu.real (shiftedFreshLargeEvent A Z U) =
        mu.real (shiftedFreshReflectedLargeEvent A Z U))
    (hU_sq : U ^ 2 ≤ V / 2)
    (hZsecond_int : Integrable (fun omega => (Z omega) ^ 2) mu)
    (hZfourth_int : Integrable (fun omega => (Z omega) ^ 4) mu)
    (hZsecond : V ≤ ∫ omega, (Z omega) ^ 2 ∂mu)
    (hZfourth : (∫ omega, (Z omega) ^ 4 ∂mu) ≤ K * V ^ 2) :
    1 / (8 * K) ≤ mu.real (endpointAbsPairSuccessEvent X M a b) := by
  let R : Omega → ℝ := fun _ => 0
  have hdecomp' :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + Z omega + R omega := by
    intro omega
    simp [R, hdecomp omega]
  have hT' : T ≤ U - 0 := by simpa using hT
  have hbad : mu.real (remainderSmallEvent R 0)ᶜ ≤ (0 : ℝ) := by
    have hcompl : (remainderSmallEvent R 0)ᶜ = (∅ : Set Omega) := by
      ext omega
      simp [remainderSmallEvent, R]
    rw [hcompl, measureReal_def, measure_empty]
    norm_num
  have hfresh :
      1 / (4 * K) ≤ mu.real (freshLargeEvent Z U) :=
    measureReal_freshLargeEvent_lower_of_second_fourth Z U V K hZ hV hK
      hU_sq hZsecond_int hZfourth_int hZsecond hZfourth
  have hlower :
      (1 / (4 * K)) / 2 - 0 ≤
        mu.real (endpointAbsPairSuccessEvent X M a b) :=
    measureReal_endpointAbsPairSuccess_lower_of_freshLarge X lambda M T U 0 a b
      A Z R (1 / (4 * K)) 0 hdecomp' hT' hM hreflect hfresh hbad
  have hconst : (1 / (4 * K)) / 2 = 1 / (8 * K) := by
    field_simp [hK.ne']
    ring
  rwa [hconst, sub_zero] at hlower

/-- Exact-increment endpoint success lower bound with reflection supplied by a
measure-preserving fresh-sign flip. -/
theorem
    measureReal_endpointAbsPairSuccess_lower_of_second_fourth_zero_remainder_of_measurePreserving
    (X : ℕ → Omega → ℝ) (lambda M T U : ℝ) (a b : ℕ)
    (A Z : Omega → ℝ) (V K : ℝ) (tau : Omega → Omega)
    (hZmeas : Measurable Z)
    (hV : 0 < V)
    (hK : 0 < K)
    (hdecomp :
