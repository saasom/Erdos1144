/-- Cardinality-budget version of the direct positive endpoint-screen
probability package.  This is the most compact arithmetic interface: the
analytic side supplies a common lower tail and one common upper envelope for
all diagonal/off-diagonal second-moment terms; Lean expands the finite sums
using the mesh cardinality. -/
structure EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  beta : ℕ → ℝ
  pairEnvelope : ℕ → ℝ
  countMean : ℕ → ℝ
  countRawSecond : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  fail_summable :
    (∑' j, ENNReal.ofReal (4 * (4 * countRawSecond j) / countMean j ^ 2)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_card_beta :
    ∀ j, countMean j ≤ ((indexSet j).card : ℝ) * beta j
  pairEnvelopeBudget_le_countRawSecond :
    ∀ j, ((indexSet j).card : ℝ) ^ 2 * pairEnvelope j ≤ countRawSecond j
  beta_le_tail_prob :
    ∀ j r, r ∈ indexSet j →
      beta j ≤
        mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
  tail_prob_le_pairEnvelope :
    ∀ j r, r ∈ indexSet j →
      mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
        ≤ pairEnvelope j
  offdiag_pair_prob_le_pairEnvelope :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j → r ≠ s →
      mu.real (endpointPositivePairScreenJointSuccessEvent M a b j r s)
        ≤ pairEnvelope j

/-- Cardinality-budget positive endpoint-screen packages imply the uniform
tail-probability certificate. -/
noncomputable def
    endpointSeparationDirectPositiveScreenUniformTailProbabilityCertificate_of_cardinality
    (h : EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate) :
    EndpointSeparationDirectPositiveScreenUniformTailProbabilityCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  beta := h.beta
  tailUpper := h.pairEnvelope
  pairUpper := h.pairEnvelope
  countMean := h.countMean
  countRawSecond := h.countRawSecond
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  countMean_le_beta_sum := by
    intro j
    calc
      h.countMean j
          ≤ ((h.indexSet j).card : ℝ) * h.beta j := h.countMean_le_card_beta j
      _ = ∑ _r ∈ h.indexSet j, h.beta j := by
            simp [Finset.sum_const, nsmul_eq_mul]
  pairBudget_le_countRawSecond := by
    intro j
    calc
      (∑ r ∈ h.indexSet j, ∑ s ∈ h.indexSet j,
        if r = s then h.pairEnvelope j else h.pairEnvelope j)
          = ((h.indexSet j).card : ℝ) ^ 2 * h.pairEnvelope j := by
            simp [Finset.sum_const, nsmul_eq_mul, pow_two]
            ring
      _ ≤ h.countRawSecond j := h.pairEnvelopeBudget_le_countRawSecond j
  beta_le_tail_prob := h.beta_le_tail_prob
  tail_prob_le_tailUpper := h.tail_prob_le_pairEnvelope
  offdiag_pair_prob_le_pairUpper := h.offdiag_pair_prob_le_pairEnvelope

/-- One- and two-point probability bounds imply the direct positive
count-moment screen certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenCountCertificate_of_tailProbability
    (h : EndpointSeparationDirectPositiveScreenTailProbabilityCertificate) :
    EndpointSeparationDirectPositiveScreenCountCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  countMean := h.countMean
  countSecond := fun j => 4 * h.countRawSecond j
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  count_centered_second_integrable := by
    intro j
    let D : Omega → ℝ :=
      endpointPositivePairSuccessCountReal h.indexSet h.a h.b h.M j
    have hmajor_int :
        Integrable (fun omega => 2 *
          (D omega ^ 2 + (∫ omega, D omega ∂mu) ^ 2)) mu := by
      exact ((integrable_endpointPositivePairSuccessCountReal_sq
        h.indexSet h.a h.b h.M j).add
        (integrable_const ((∫ omega, D omega ∂mu) ^ 2))).const_mul 2
    refine Integrable.mono' hmajor_int ?_ ?_
    · have hcenter_ae :=
        (((integrable_endpointPositivePairSuccessCountReal
          h.indexSet h.a h.b h.M j).sub
          (integrable_const (∫ omega, D omega ∂mu))).aemeasurable.pow_const 2)
      exact hcenter_ae.aestronglyMeasurable
    · filter_upwards [] with omega
      rw [Real.norm_eq_abs,
        abs_of_nonneg
          (by positivity : 0 ≤ (D omega - ∫ omega, D omega ∂mu) ^ 2)]
      nlinarith [sq_nonneg (D omega - ∫ omega, D omega ∂mu),
        sq_nonneg (D omega + ∫ omega, D omega ∂mu)]
  count_mean_lower := by
    intro j
    calc
      h.countMean j
          ≤ ∑ r ∈ h.indexSet j, h.tailLower j r :=
            h.countMean_le_tailLower_sum j
      _ ≤
          ∑ r ∈ h.indexSet j,
            mu.real
              (endpointPositivePairSuccessEvent (h.M j) (h.a j r) (h.b j r)) := by
            refine Finset.sum_le_sum fun r hr => ?_
            exact h.tailLower_le_prob j r hr
      _ =
          ∫ omega,
            endpointPositivePairSuccessCountReal h.indexSet h.a h.b h.M j omega ∂mu := by
            exact
              (integral_endpointPositivePairSuccessCountReal
                h.indexSet h.a h.b h.M j).symm
  count_centered_second_upper := by
    intro j
    let D : Omega → ℝ :=
      endpointPositivePairSuccessCountReal h.indexSet h.a h.b h.M j
    calc
      (∫ omega, (D omega - ∫ omega', D omega' ∂mu) ^ 2 ∂mu)
          ≤ 4 * ∫ omega, D omega ^ 2 ∂mu :=
            centered_second_le_four_raw_second
              (D := D)
              (integrable_endpointPositivePairSuccessCountReal
                h.indexSet h.a h.b h.M j)
              (integrable_endpointPositivePairSuccessCountReal_sq
                h.indexSet h.a h.b h.M j)
      _ ≤
          4 *
            (∑ r ∈ h.indexSet j, ∑ s ∈ h.indexSet j,
              mu.real
                (endpointPositivePairScreenJointSuccessEvent h.M h.a h.b j r s)) := by
            rw [integral_endpointPositivePairSuccessCountReal_sq
              h.indexSet h.a h.b h.M j]
      _ ≤ 4 * (∑ r ∈ h.indexSet j, ∑ s ∈ h.indexSet j,
            h.pairUpper j r s) := by
            refine mul_le_mul_of_nonneg_left ?_ (by norm_num : (0 : ℝ) ≤ 4)
            refine Finset.sum_le_sum fun r hr => ?_
            refine Finset.sum_le_sum fun s hs => ?_
            exact h.pair_prob_le_pairUpper j r s hr hs
      _ ≤ 4 * h.countRawSecond j := by
            exact mul_le_mul_of_nonneg_left
              (h.pairUpper_sum_le_countRawSecond j) (by norm_num : (0 : ℝ) ≤ 4)

