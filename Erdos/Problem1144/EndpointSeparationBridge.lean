/-- Indexed real-budget endpoint-screen certificate whose one-point lower
bounds are supplied by finite fresh-walk endpoint separations.

This is the most flexible finite-walk mesh interface: the lower tail and the
joint upper bound may both depend on the individual mesh points. -/
structure EndpointSeparationAbsScreenTailProbabilityFiniteFreshWalkRealBudgetCertificate
    where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  tailLower : ℕ → ℕ → ℝ
  pairUpper : ℕ → ℕ → ℕ → ℝ
  countMean : ℕ → ℝ
  countRawSecond : ℕ → ℝ
  failBound : ℕ → ℝ
  lambda : ℕ → ℕ → ℝ
  T : ℕ → ℕ → ℝ
  U : ℕ → ℕ → ℝ
  eps : ℕ → ℕ → ℝ
  A : ℕ → ℕ → Omega → ℝ
  R : ℕ → ℕ → Omega → ℝ
  freshSet : ℕ → ℕ → Finset ℕ
  coeff : ℕ → ℕ → ℕ → ℝ
  second : ℕ → ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  failBound_summable : Summable failBound
  failBudget_le_failBound :
    ∀ j, 4 * (4 * countRawSecond j) / countMean j ^ 2 ≤ failBound j
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_tailLower_sum :
    ∀ j, countMean j ≤ ∑ r ∈ indexSet j, tailLower j r
  pairUpper_sum_le_countRawSecond :
    ∀ j,
      (∑ r ∈ indexSet j, ∑ s ∈ indexSet j, pairUpper j r s)
        ≤ countRawSecond j
  tailLower_le_freshLower :
    ∀ j r, r ∈ indexSet j →
      tailLower j r ≤ (1 : ℝ) / 24 - second j r / eps j r ^ 2
  variance_pos :
    ∀ j r, r ∈ indexSet j →
      0 < ∑ p ∈ freshSet j r, coeff j r p ^ 2
  eps_pos :
    ∀ j r, r ∈ indexSet j → 0 < eps j r
  decomp :
    ∀ j r, r ∈ indexSet j →
      ∀ omega,
        endpointSeparationValue
            (fun N omega => normSum omega N) (lambda j r) (a j r) (b j r) omega =
          A j r omega + epsLinearForm (freshSet j r) (coeff j r) omega +
            R j r omega
  separation_threshold :
    ∀ j r, r ∈ indexSet j → T j r ≤ U j r - eps j r
  endpoint_screen :
    ∀ j r, r ∈ indexSet j → (1 + |lambda j r|) * M j < T j r
  background_invariant :
    ∀ j r, r ∈ indexSet j →
      ∀ omega, A j r (freshSignFlip (freshSet j r) omega) = A j r omega
  fresh_threshold_sq :
    ∀ j r, r ∈ indexSet j →
      U j r ^ 2 ≤ (∑ p ∈ freshSet j r, coeff j r p ^ 2) / 2
  remainder_sq_integrable :
    ∀ j r, r ∈ indexSet j →
      Integrable (fun omega => (R j r omega) ^ 2) mu
  remainder_second_le :
    ∀ j r, r ∈ indexSet j →
      (∫ omega, (R j r omega) ^ 2 ∂mu) ≤ second j r
  pair_prob_le_pairUpper :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j →
      mu.real (endpointAbsPairScreenJointSuccessEvent M a b j r s)
        ≤ pairUpper j r s

/-- Indexed finite fresh-walk real-budget certificates produce the ordinary
indexed tail-probability screen certificate. -/
noncomputable def
    endpointSeparationAbsScreenTailProbabilityCertificate_of_finiteFreshWalkRealBudget
    (h :
      EndpointSeparationAbsScreenTailProbabilityFiniteFreshWalkRealBudgetCertificate) :
    EndpointSeparationAbsScreenTailProbabilityCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  tailLower := h.tailLower
  pairUpper := h.pairUpper
  countMean := h.countMean
  countRawSecond := h.countRawSecond
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  fail_summable := by
    have hle :
        (∑' j,
            ENNReal.ofReal
              (4 * (4 * h.countRawSecond j) / h.countMean j ^ 2))
          ≤ ∑' j, ENNReal.ofReal (h.failBound j) := by
      exact ENNReal.tsum_le_tsum fun j =>
        ENNReal.ofReal_le_ofReal (h.failBudget_le_failBound j)
    exact ne_top_of_le_ne_top h.failBound_summable.tsum_ofReal_ne_top hle
  endpoints_in_block := h.endpoints_in_block
  countMean_le_tailLower_sum := h.countMean_le_tailLower_sum
  pairUpper_sum_le_countRawSecond := h.pairUpper_sum_le_countRawSecond
  tailLower_le_prob := by
    intro j r hr
    calc
      h.tailLower j r
          ≤ (1 : ℝ) / 24 - h.second j r / h.eps j r ^ 2 :=
            h.tailLower_le_freshLower j r hr
      _ ≤
          mu.real
            (endpointAbsPairSuccessEvent
              (fun N omega => normSum omega N) (h.M j) (h.a j r) (h.b j r)) :=
            measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_of_freshSignFlip
              (fun N omega => normSum omega N) (h.lambda j r) (h.M j)
              (h.T j r) (h.U j r) (h.eps j r) (h.a j r) (h.b j r)
              (h.A j r) (h.R j r) (h.freshSet j r) (h.coeff j r)
              (h.second j r) (h.variance_pos j r hr) (h.eps_pos j r hr)
              (h.decomp j r hr) (h.separation_threshold j r hr)
              (h.endpoint_screen j r hr) (h.background_invariant j r hr)
              (h.fresh_threshold_sq j r hr) (h.remainder_sq_integrable j r hr)
              (h.remainder_second_le j r hr)
  pair_prob_le_pairUpper := h.pair_prob_le_pairUpper

