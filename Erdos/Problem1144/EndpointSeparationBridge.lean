/-- Cardinality-budget version with an ordinary real summable failure envelope.
This is the same analytic interface as
`EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate`,
but the paper side may provide a cleaner real sequence `failBound` dominating
the Chebyshev/cardinality budget. -/
structure EndpointSeparationDirectPositiveScreenCardinalityRealBudgetCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  beta : ℕ → ℝ
  pairEnvelope : ℕ → ℝ
  countMean : ℕ → ℝ
  countRawSecond : ℕ → ℝ
  failBound : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  failBound_summable : Summable failBound
  failBudget_le_failBound :
    ∀ j, 4 * (4 * countRawSecond j) / countMean j ^ 2 ≤ failBound j
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_card_beta :
    ∀ j, countMean j ≤ ((indexSet j).card : ℝ) * beta j
  pairEnvelopeBudget_le_countRawSecond :
    ∀ j, ((indexSet j).card : ℝ) ^ 2 * pairEnvelope j ≤ countRawSecond j
  beta_le_tail_prob :
    ∀ j r, r ∈ indexSet j →
      beta j ≤
        mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
  tail_prob_le_pairEnvelope :
    ∀ j r, r ∈ indexSet j →
      mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
        ≤ pairEnvelope j
  offdiag_pair_prob_le_pairEnvelope :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j → r ≠ s →
      mu.real (endpointPositivePairScreenJointSuccessEvent M a b j r s)
        ≤ pairEnvelope j

/-- A real summable cardinality budget produces the corresponding
`ENNReal`-summable cardinality certificate. -/
noncomputable def
    endpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate_of_realBudget
    (h : EndpointSeparationDirectPositiveScreenCardinalityRealBudgetCertificate) :
    EndpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  beta := h.beta
  pairEnvelope := h.pairEnvelope
  countMean := h.countMean
  countRawSecond := h.countRawSecond
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  fail_summable := by
    have hle :
        (∑' j,
            ENNReal.ofReal
              (4 * (4 * h.countRawSecond j) / h.countMean j ^ 2))
          ≤ ∑' j, ENNReal.ofReal (h.failBound j) := by
      exact ENNReal.tsum_le_tsum fun j =>
        ENNReal.ofReal_le_ofReal (h.failBudget_le_failBound j)
    exact ne_top_of_le_ne_top h.failBound_summable.tsum_ofReal_ne_top hle
  endpoints_in_block := h.endpoints_in_block
  countMean_le_card_beta := h.countMean_le_card_beta
  pairEnvelopeBudget_le_countRawSecond := h.pairEnvelopeBudget_le_countRawSecond
  beta_le_tail_prob := h.beta_le_tail_prob
  tail_prob_le_pairEnvelope := h.tail_prob_le_pairEnvelope
  offdiag_pair_prob_le_pairEnvelope := h.offdiag_pair_prob_le_pairEnvelope

/-- Real-budget cardinality positive endpoint-screen probability estimates
produce the direct all-positive-screens-fail certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenCertificate_of_cardinalityRealBudget
    (h : EndpointSeparationDirectPositiveScreenCardinalityRealBudgetCertificate) :
    EndpointSeparationDirectPositiveScreenCertificate :=
  endpointSeparationDirectPositiveScreenCertificate_of_cardinalityTailProbability
    (endpointSeparationDirectPositiveScreenCardinalityTailProbabilityCertificate_of_realBudget h)

/-- Direct final handoff from real-budget cardinality positive endpoint-screen
probability estimates. -/
theorem erdos1144_of_endpointSeparationDirectPositiveScreenCardinalityRealBudgetCertificate
    (h : EndpointSeparationDirectPositiveScreenCardinalityRealBudgetCertificate) :
    Erdos1144 :=
  erdos1144_of_endpointSeparationDirectPositiveScreenCertificate
    (endpointSeparationDirectPositiveScreenCertificate_of_cardinalityRealBudget h)

/-- Direct positive pierced-screen certificate.  This is the natural
real-probability form of the direct one-sided analytic theorem: with probability
at least `1 - fail j`, some positive endpoint-pair screen is pierced. -/
structure EndpointSeparationDirectPositivePiercedScreenCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  fail : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  fail_summable : (∑' j, ENNReal.ofReal (fail j)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  prob_some_pair_success :
    ∀ j,
      1 - fail j ≤
        mu.real
          {omega |
            ∃ r, r ∈ indexSet j ∧
              omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)}

/-- Convert a direct positive pierced-screen certificate to the existing
all-screens-fail certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenCertificate_of_pierced
    (h : EndpointSeparationDirectPositivePiercedScreenCertificate) :
    EndpointSeparationDirectPositiveScreenCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  fail := fun j => ENNReal.ofReal (h.fail j)
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  prob_screen_failure := by
    intro j
    exact
      measure_endpointPositiveScreenFailureEvent_le_of_exists_pairSuccess_measureReal
        h.indexSet h.a h.b h.M j (h.fail j) (h.prob_some_pair_success j)

/-- Direct final handoff for one-sided pierced positive endpoint screens. -/
theorem erdos1144_of_endpointSeparationDirectPositivePiercedScreenCertificate
    (h : EndpointSeparationDirectPositivePiercedScreenCertificate) :
    Erdos1144 :=
  erdos1144_of_endpointSeparationDirectPositiveScreenCertificate
    (endpointSeparationDirectPositiveScreenCertificate_of_pierced h)

/-- Direct positive pierced-screen certificate with ordinary real summability
