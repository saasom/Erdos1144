/-- A real summable absolute count budget produces the corresponding
`ENNReal`-summable count certificate. -/
noncomputable def endpointSeparationAbsScreenCountCertificate_of_realBudget
    (h : EndpointSeparationAbsScreenCountRealBudgetCertificate) :
    EndpointSeparationAbsScreenCountCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
