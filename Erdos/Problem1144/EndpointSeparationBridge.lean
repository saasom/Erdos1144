/-- One- and two-point probability version of the direct positive
endpoint-screen count certificate.  This is the natural output of a
many-trial analytic theorem: lower bounds for individual positive screen
piercings and upper bounds for joint piercings. -/
structure EndpointSeparationDirectPositiveScreenTailProbabilityCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  tailLower : ℕ → ℕ → ℝ
  pairUpper : ℕ → ℕ → ℕ → ℝ
  countMean : ℕ → ℝ
  countRawSecond : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  fail_summable :
    (∑' j, ENNReal.ofReal (4 * (4 * countRawSecond j) / countMean j ^ 2)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_tailLower_sum :
    ∀ j,
      countMean j ≤
        ∑ r ∈ indexSet j, tailLower j r
  pairUpper_sum_le_countRawSecond :
    ∀ j,
      (∑ r ∈ indexSet j, ∑ s ∈ indexSet j, pairUpper j r s)
        ≤ countRawSecond j
  tailLower_le_prob :
    ∀ j r, r ∈ indexSet j →
      tailLower j r ≤
        mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
  pair_prob_le_pairUpper :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j →
      mu.real (endpointPositivePairScreenJointSuccessEvent M a b j r s)
        ≤ pairUpper j r s

/-- Uniform one- and two-point probability package for direct positive
endpoint screens.  This is the compact analytic shape: a common lower bound
for each screen, a common one-point upper bound for diagonal second-moment
terms, and a common off-diagonal joint upper bound. -/
structure EndpointSeparationDirectPositiveScreenUniformTailProbabilityCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  beta : ℕ → ℝ
  tailUpper : ℕ → ℝ
  pairUpper : ℕ → ℝ
  countMean : ℕ → ℝ
  countRawSecond : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  fail_summable :
    (∑' j, ENNReal.ofReal (4 * (4 * countRawSecond j) / countMean j ^ 2)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  countMean_le_beta_sum :
    ∀ j,
      countMean j ≤
        ∑ _r ∈ indexSet j, beta j
  pairBudget_le_countRawSecond :
    ∀ j,
      (∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
        if r = s then tailUpper j else pairUpper j)
        ≤ countRawSecond j
  beta_le_tail_prob :
    ∀ j r, r ∈ indexSet j →
      beta j ≤
        mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
  tail_prob_le_tailUpper :
    ∀ j r, r ∈ indexSet j →
      mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
        ≤ tailUpper j
  offdiag_pair_prob_le_pairUpper :
    ∀ j r s, r ∈ indexSet j → s ∈ indexSet j → r ≠ s →
      mu.real (endpointPositivePairScreenJointSuccessEvent M a b j r s)
        ≤ pairUpper j

/-- Uniform direct-positive probability packages imply the fully indexed
tail-probability certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenTailProbabilityCertificate_of_uniform
    (h : EndpointSeparationDirectPositiveScreenUniformTailProbabilityCertificate) :
    EndpointSeparationDirectPositiveScreenTailProbabilityCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  tailLower := fun j _r => h.beta j
  pairUpper := fun j r s => if r = s then h.tailUpper j else h.pairUpper j
  countMean := h.countMean
  countRawSecond := h.countRawSecond
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  countMean_pos := h.countMean_pos
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  countMean_le_tailLower_sum := h.countMean_le_beta_sum
  pairUpper_sum_le_countRawSecond := h.pairBudget_le_countRawSecond
  tailLower_le_prob := h.beta_le_tail_prob
  pair_prob_le_pairUpper := by
    intro j r s hr hs
    by_cases hrs : r = s
    · subst s
      have hsubset :
          endpointPositivePairScreenJointSuccessEvent h.M h.a h.b j r r ⊆
            endpointPositivePairSuccessEvent (h.M j) (h.a j r) (h.b j r) := by
        intro omega homega
        exact homega.1
      have hdiag :
          mu.real (endpointPositivePairScreenJointSuccessEvent h.M h.a h.b j r r)
            ≤
          mu.real (endpointPositivePairSuccessEvent (h.M j) (h.a j r) (h.b j r)) :=
        measureReal_mono hsubset
      simpa using (hdiag.trans (h.tail_prob_le_tailUpper j r hr))
    · simpa [hrs] using h.offdiag_pair_prob_le_pairUpper j r s hr hs hrs

