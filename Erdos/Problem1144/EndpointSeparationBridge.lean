/-!
### One-block finite fresh-walk certificates

The next two records package the fields needed by the finite Rademacher
endpoint-separation wrappers above.  They are intentionally local: a
many-trial Harperized screen theorem can prove one such lower bound for each
candidate endpoint pair, then feed the separate screen-piercing certificates
below.
-/

/-- One endpoint-separation pair with a finite fresh Rademacher walk and an
`L^2` residue budget.  The fresh reflection is the concrete flip of the
coordinates in `freshSet`; the only invariance field is that the background
term `A` is unchanged by this flip. -/
structure EndpointSeparationFiniteFreshWalkCertificate where
  X : ℕ → Omega → ℝ
  lambda : ℝ
  M : ℝ
  T : ℝ
  U : ℝ
  eps : ℝ
  a : ℕ
  b : ℕ
  A : Omega → ℝ
  R : Omega → ℝ
  freshSet : Finset ℕ
  coeff : ℕ → ℝ
  second : ℝ
  variance_pos : 0 < ∑ p ∈ freshSet, coeff p ^ 2
  eps_pos : 0 < eps
  decomp :
    ∀ omega,
      endpointSeparationValue X lambda a b omega =
        A omega + epsLinearForm freshSet coeff omega + R omega
  separation_threshold : T ≤ U - eps
  endpoint_screen : (1 + |lambda|) * M < T
  background_invariant :
    ∀ omega, A (freshSignFlip freshSet omega) = A omega
  fresh_threshold_sq : U ^ 2 ≤ (∑ p ∈ freshSet, coeff p ^ 2) / 2
  remainder_sq_integrable : Integrable (fun omega => (R omega) ^ 2) mu
  remainder_second_le :
    (∫ omega, (R omega) ^ 2 ∂mu) ≤ second

/-- A one-block finite fresh-walk certificate gives the endpoint absolute
success lower bound with the standard finite Rademacher constant. -/
theorem EndpointSeparationFiniteFreshWalkCertificate.measureReal_endpointAbsPairSuccess_lower
    (h : EndpointSeparationFiniteFreshWalkCertificate) :
    (1 : ℝ) / 24 - h.second / h.eps ^ 2 ≤
      mu.real (endpointAbsPairSuccessEvent h.X h.M h.a h.b) :=
  measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_of_freshSignFlip
    h.X h.lambda h.M h.T h.U h.eps h.a h.b h.A h.R h.freshSet h.coeff
    h.second h.variance_pos h.eps_pos h.decomp h.separation_threshold
    h.endpoint_screen h.background_invariant h.fresh_threshold_sq
    h.remainder_sq_integrable h.remainder_second_le

/-- Exact one endpoint-separation pair with a finite fresh Rademacher walk and
no residue.  This is the cleanest local interface for endpoint shell
increments and any other construction where the selected fresh coordinates
give an exact decomposition. -/
structure EndpointSeparationFiniteFreshWalkZeroRemainderCertificate where
  X : ℕ → Omega → ℝ
  lambda : ℝ
  M : ℝ
  T : ℝ
  U : ℝ
  a : ℕ
  b : ℕ
  A : Omega → ℝ
  freshSet : Finset ℕ
  coeff : ℕ → ℝ
  variance_pos : 0 < ∑ p ∈ freshSet, coeff p ^ 2
  decomp :
    ∀ omega,
      endpointSeparationValue X lambda a b omega =
        A omega + epsLinearForm freshSet coeff omega
  separation_threshold : T ≤ U
  endpoint_screen : (1 + |lambda|) * M < T
  background_invariant :
    ∀ omega, A (freshSignFlip freshSet omega) = A omega
  fresh_threshold_sq : U ^ 2 ≤ (∑ p ∈ freshSet, coeff p ^ 2) / 2

namespace EndpointSeparationFiniteFreshWalkZeroRemainderCertificate

/-- A zero-remainder one-block finite fresh-walk certificate gives the clean
`1/24` endpoint absolute-success lower bound. -/
theorem measureReal_endpointAbsPairSuccess_lower
    (h : EndpointSeparationFiniteFreshWalkZeroRemainderCertificate) :
    (1 : ℝ) / 24 ≤
      mu.real (endpointAbsPairSuccessEvent h.X h.M h.a h.b) :=
  measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_zero_remainder_of_freshSignFlip
    h.X h.lambda h.M h.T h.U h.a h.b h.A h.freshSet h.coeff h.variance_pos
    h.decomp h.separation_threshold h.endpoint_screen h.background_invariant
    h.fresh_threshold_sq

end EndpointSeparationFiniteFreshWalkZeroRemainderCertificate

/-- Two raw endpoints inside a deterministic block give an absolute block
success. -/
theorem endpointAbsPairSuccess_subset_absBlockSuccess
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ) (a b j : ℕ)
    (ha : a ∈ Finset.Icc (lo j) (hi j))
    (hb : b ∈ Finset.Icc (lo j) (hi j)) :
    endpointAbsPairSuccessEvent (fun N omega => normSum omega N) (M j) a b ⊆
      {omega | absBlockSuccess lo hi M omega j} := by
  intro omega homega
  change M j ≤ |normSum omega a| ∨ M j ≤ |normSum omega b| at homega
  rcases homega with hleft | hright
  · exact ⟨a, ha, hleft⟩
  · exact ⟨b, hb, hright⟩

/-- At least one of two raw endpoints is positive and large. -/
def endpointPositivePairSuccessEvent (M : ℝ) (a b : ℕ) : Set Omega :=
  {omega | M ≤ normSum omega a ∨ M ≤ normSum omega b}

/-- Measurability of the positive endpoint-pair event. -/
theorem measurableSet_endpointPositivePairSuccessEvent
    (M : ℝ) (a b : ℕ) :
    MeasurableSet (endpointPositivePairSuccessEvent M a b) := by
  have ha : MeasurableSet {omega : Omega | M ≤ normSum omega a} :=
    measurableSet_le measurable_const (measurable_normSum a)
  have hb : MeasurableSet {omega : Omega | M ≤ normSum omega b} :=
    measurableSet_le measurable_const (measurable_normSum b)
  exact ha.union hb

/-- Positive endpoint-pair success is stronger than absolute endpoint-pair
success. -/
theorem endpointPositivePairSuccess_subset_endpointAbsPairSuccess
    (M : ℝ) (a b : ℕ) :
    endpointPositivePairSuccessEvent M a b ⊆
      endpointAbsPairSuccessEvent (fun N omega => normSum omega N) M a b := by
  intro omega homega
  change M ≤ normSum omega a ∨ M ≤ normSum omega b at homega
  change M ≤ |normSum omega a| ∨ M ≤ |normSum omega b|
  rcases homega with hleft | hright
  · exact Or.inl (le_trans hleft (le_abs_self _))
  · exact Or.inr (le_trans hright (le_abs_self _))

/-- Two raw endpoints inside a deterministic block give a positive block
success when one of the endpoints is positive and large. -/
theorem endpointPositivePairSuccess_subset_blockSuccess
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ) (a b j : ℕ)
    (ha : a ∈ Finset.Icc (lo j) (hi j))
    (hb : b ∈ Finset.Icc (lo j) (hi j)) :
    endpointPositivePairSuccessEvent (M j) a b ⊆
      {omega | blockSuccess lo hi M omega j} := by
  intro omega homega
  change M j ≤ normSum omega a ∨ M j ≤ normSum omega b at homega
  rcases homega with hleft | hright
  · exact ⟨a, ha, hleft⟩
  · exact ⟨b, hb, hright⟩

/-- All positive endpoint-pair screens in a block fail to be pierced.  This is
the direct one-sided analogue of `endpointAbsScreenFailureEvent`. -/
def endpointPositiveScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) : Set Omega :=
  {omega |
    ∀ r, r ∈ indexSet j →
      omega ∉ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)}

/-- The complement of positive screen failure is the event that at least one
positive endpoint-pair screen is pierced. -/
theorem endpointPositiveScreenFailureEvent_compl_eq_exists_pairSuccess
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (endpointPositiveScreenFailureEvent indexSet a b M j)ᶜ =
      {omega |
        ∃ r, r ∈ indexSet j ∧
          omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)} := by
  ext omega
  simp [endpointPositiveScreenFailureEvent]

/-- A single pierced positive endpoint-pair screen rules out the all-screens-fail
event. -/
theorem endpointPositivePairSuccess_subset_endpointPositiveScreenFailureEvent_compl
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j r : ℕ) (hr : r ∈ indexSet j) :
    endpointPositivePairSuccessEvent (M j) (a j r) (b j r) ⊆
      (endpointPositiveScreenFailureEvent indexSet a b M j)ᶜ := by
  intro omega hpair hfail
  exact hfail r hr hpair

/-- The positive all-screens-fail event is measurable. -/
theorem measurableSet_endpointPositiveScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    MeasurableSet (endpointPositiveScreenFailureEvent indexSet a b M j) := by
  rw [show endpointPositiveScreenFailureEvent indexSet a b M j =
      ⋂ r, if r ∈ indexSet j then
        (endpointPositivePairSuccessEvent (M j) (a j r) (b j r))ᶜ
      else Set.univ by
        ext omega
        simp [endpointPositiveScreenFailureEvent]]
  exact MeasurableSet.iInter fun r => by
    by_cases hr : r ∈ indexSet j
    · simp [hr, (measurableSet_endpointPositivePairSuccessEvent
        (M j) (a j r) (b j r)).compl]
    · simp [hr]

/-- If the pierced-positive-screen event has real probability at least
`1 - delta`, then the all-positive-screens-fail event has `ENNReal` probability
at most `delta`. -/
theorem measure_endpointPositiveScreenFailureEvent_le_of_exists_pairSuccess_measureReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (delta : ℝ)
    (hpierce :
      1 - delta ≤
        mu.real
          {omega |
            ∃ r, r ∈ indexSet j ∧
              omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)}) :
    mu (endpointPositiveScreenFailureEvent indexSet a b M j) ≤
      ENNReal.ofReal delta := by
  let F := endpointPositiveScreenFailureEvent indexSet a b M j
  have hcompl_lower : 1 - delta ≤ mu.real Fᶜ := by
    simpa [F, endpointPositiveScreenFailureEvent_compl_eq_exists_pairSuccess]
      using hpierce
  have hle : mu (Fᶜ)ᶜ ≤ ENNReal.ofReal delta :=
    measure_compl_le_of_measureReal_ge_one_sub Fᶜ delta
      (measurableSet_endpointPositiveScreenFailureEvent indexSet a b M j).compl
      hcompl_lower
  simpa [F] using hle

/-- Real-valued count of pierced positive endpoint-pair screens in one block. -/
noncomputable def endpointPositivePairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) : ℝ := by
  classical
  exact
    (((indexSet j).filter fun r =>
      omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)).card : ℝ)

/-- Pointwise expansion of the positive endpoint-pair count as a finite sum of
event indicators. -/
theorem endpointPositivePairSuccessCountReal_eq_sum_indicator
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) :
    endpointPositivePairSuccessCountReal indexSet a b M j omega =
      ∑ r ∈ indexSet j,
        (endpointPositivePairSuccessEvent (M j) (a j r) (b j r)).indicator
          (fun _ : Omega => (1 : ℝ)) omega := by
  classical
  unfold endpointPositivePairSuccessCountReal
  rw [Finset.card_filter]
  rw [Nat.cast_sum]
  refine Finset.sum_congr rfl fun r hr => ?_
  by_cases hpair : omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)
  · simp [hpair]
  · simp [hpair]

/-- Two positive endpoint-pair screens are pierced simultaneously. -/
def endpointPositivePairScreenJointSuccessEvent
    (M : ℕ → ℝ) (a b : ℕ → ℕ → ℕ) (j r s : ℕ) : Set Omega :=
  endpointPositivePairSuccessEvent (M j) (a j r) (b j r) ∩
    endpointPositivePairSuccessEvent (M j) (a j s) (b j s)

/-- Measurability of the joint positive endpoint-pair screen event. -/
theorem measurableSet_endpointPositivePairScreenJointSuccessEvent
    (M : ℕ → ℝ) (a b : ℕ → ℕ → ℕ) (j r s : ℕ) :
    MeasurableSet (endpointPositivePairScreenJointSuccessEvent M a b j r s) := by
  exact
    (measurableSet_endpointPositivePairSuccessEvent (M j) (a j r) (b j r)).inter
      (measurableSet_endpointPositivePairSuccessEvent (M j) (a j s) (b j s))

/-- The pointwise square of the positive endpoint-pair count expands into the
double sum of joint-screen indicators. -/
theorem endpointPositivePairSuccessCountReal_sq_eq_sum_joint_indicator
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) :
    (endpointPositivePairSuccessCountReal indexSet a b M j omega) ^ 2 =
      ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
        (endpointPositivePairScreenJointSuccessEvent M a b j r s).indicator
          (fun _ : Omega => (1 : ℝ)) omega := by
  classical
  rw [endpointPositivePairSuccessCountReal_eq_sum_indicator]
  rw [pow_two, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun r hr => ?_
  refine Finset.sum_congr rfl fun s hs => ?_
  by_cases hrω :
      omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)
  · by_cases hsω :
        omega ∈ endpointPositivePairSuccessEvent (M j) (a j s) (b j s)
    · simp [endpointPositivePairScreenJointSuccessEvent, hrω, hsω]
    · simp [endpointPositivePairScreenJointSuccessEvent, hrω, hsω]
  · simp [endpointPositivePairScreenJointSuccessEvent, hrω]

/-- The positive endpoint-pair count is integrable. -/
theorem integrable_endpointPositivePairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    Integrable (endpointPositivePairSuccessCountReal indexSet a b M j) mu := by
  classical
  rw [show endpointPositivePairSuccessCountReal indexSet a b M j =
      fun omega =>
        ∑ r ∈ indexSet j,
          (endpointPositivePairSuccessEvent (M j) (a j r) (b j r)).indicator
            (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointPositivePairSuccessCountReal_eq_sum_indicator
          indexSet a b M j omega]
  refine integrable_finset_sum (indexSet j) ?_
  intro r _hr
  exact
    (integrable_const (1 : ℝ)).indicator
      (measurableSet_endpointPositivePairSuccessEvent (M j) (a j r) (b j r))

/-- The square of the positive endpoint-pair count is integrable. -/
theorem integrable_endpointPositivePairSuccessCountReal_sq
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    Integrable
      (fun omega => (endpointPositivePairSuccessCountReal indexSet a b M j omega) ^ 2)
      mu := by
  classical
  rw [show
      (fun omega =>
        (endpointPositivePairSuccessCountReal indexSet a b M j omega) ^ 2) =
        fun omega =>
          ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
            (endpointPositivePairScreenJointSuccessEvent M a b j r s).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointPositivePairSuccessCountReal_sq_eq_sum_joint_indicator
          indexSet a b M j omega]
  refine integrable_finset_sum (indexSet j) ?_
  intro r _hr
  refine integrable_finset_sum (indexSet j) ?_
  intro s _hs
  exact
    (integrable_const (1 : ℝ)).indicator
      (measurableSet_endpointPositivePairScreenJointSuccessEvent M a b j r s)

/-- First-moment identity for the positive endpoint-pair screen count. -/
theorem integral_endpointPositivePairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (∫ omega, endpointPositivePairSuccessCountReal indexSet a b M j omega ∂mu)
      =
    ∑ r ∈ indexSet j,
      mu.real (endpointPositivePairSuccessEvent (M j) (a j r) (b j r)) := by
  classical
  rw [show
      (fun omega => endpointPositivePairSuccessCountReal indexSet a b M j omega) =
        fun omega =>
          ∑ r ∈ indexSet j,
            (endpointPositivePairSuccessEvent (M j) (a j r) (b j r)).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointPositivePairSuccessCountReal_eq_sum_indicator
          indexSet a b M j omega]
  rw [integral_finset_sum]
  · refine Finset.sum_congr rfl fun r _hr => ?_
    exact
      MeasureTheory.integral_indicator_one
        (measurableSet_endpointPositivePairSuccessEvent (M j) (a j r) (b j r))
  · intro r _hr
    exact
      (integrable_const (1 : ℝ)).indicator
        (measurableSet_endpointPositivePairSuccessEvent (M j) (a j r) (b j r))

/-- Raw second-moment identity for the positive endpoint-pair screen count. -/
theorem integral_endpointPositivePairSuccessCountReal_sq
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (∫ omega, (endpointPositivePairSuccessCountReal indexSet a b M j omega) ^ 2 ∂mu)
      =
    ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
      mu.real (endpointPositivePairScreenJointSuccessEvent M a b j r s) := by
  classical
  rw [show
      (fun omega =>
        (endpointPositivePairSuccessCountReal indexSet a b M j omega) ^ 2) =
        fun omega =>
          ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
            (endpointPositivePairScreenJointSuccessEvent M a b j r s).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointPositivePairSuccessCountReal_sq_eq_sum_joint_indicator
          indexSet a b M j omega]
  rw [integral_finset_sum]
  · refine Finset.sum_congr rfl fun r _hr => ?_
    rw [integral_finset_sum]
    · refine Finset.sum_congr rfl fun s _hs => ?_
      exact
        MeasureTheory.integral_indicator_one
          (measurableSet_endpointPositivePairScreenJointSuccessEvent M a b j r s)
    · intro s _hs
      exact
        (integrable_const (1 : ℝ)).indicator
          (measurableSet_endpointPositivePairScreenJointSuccessEvent M a b j r s)
  · intro r _hr
    refine integrable_finset_sum (indexSet j) ?_
    intro s _hs
    exact
      (integrable_const (1 : ℝ)).indicator
        (measurableSet_endpointPositivePairScreenJointSuccessEvent M a b j r s)

/-- If all positive screens fail, then the pierced-positive count is zero and
in particular below half of any positive target mean. -/
theorem endpointPositiveScreenFailureEvent_subset_count_lt_half
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (m : ℝ) (hm : 0 < m) :
    endpointPositiveScreenFailureEvent indexSet a b M j ⊆
      {omega |
        endpointPositivePairSuccessCountReal indexSet a b M j omega < m / 2} := by
  classical
  intro omega hfail
  have hfilter :
      ((indexSet j).filter fun r =>
        omega ∈ endpointPositivePairSuccessEvent (M j) (a j r) (b j r)) = ∅ := by
    ext r
    constructor
    · intro hr
      rw [Finset.mem_filter] at hr
      exact (hfail r hr.1 hr.2).elim
    · intro hr
      simp at hr
  have hcount :
      endpointPositivePairSuccessCountReal indexSet a b M j omega = 0 := by
    unfold endpointPositivePairSuccessCountReal
    rw [hfilter]
    simp
  change endpointPositivePairSuccessCountReal indexSet a b M j omega < m / 2
  rw [hcount]
  linarith

/-- A centered second-moment estimate for the pierced positive endpoint-pair
count pays the positive all-screens-fail event. -/
theorem measure_endpointPositiveScreenFailureEvent_le_count_second
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (countMean countSecond : ℝ)
    (hmean_pos : 0 < countMean)
    (hsecond_int :
      Integrable
        (fun omega =>
          (endpointPositivePairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointPositivePairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2)
        mu)
    (hmean :
      countMean ≤
        ∫ omega, endpointPositivePairSuccessCountReal indexSet a b M j omega ∂mu)
    (hsecond :
      (∫ omega,
          (endpointPositivePairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointPositivePairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2 ∂mu)
        ≤ countSecond) :
    mu (endpointPositiveScreenFailureEvent indexSet a b M j) ≤
      ENNReal.ofReal (4 * countSecond / countMean ^ 2) := by
  calc
    mu (endpointPositiveScreenFailureEvent indexSet a b M j)
        ≤ mu
            {omega |
              endpointPositivePairSuccessCountReal indexSet a b M j omega <
                countMean / 2} :=
          measure_mono
            (endpointPositiveScreenFailureEvent_subset_count_lt_half
              indexSet a b M j countMean hmean_pos)
    _ ≤ ENNReal.ofReal (4 * countSecond / countMean ^ 2) :=
          measure_lt_half_mean_le_centered_second
            (endpointPositivePairSuccessCountReal indexSet a b M j)
            countMean countSecond hmean_pos hsecond_int hmean hsecond

/-- If both endpoints of every candidate pair lie in the raw block, then raw
positive block failure forces all positive endpoint-pair screens to fail. -/
theorem blockFailure_subset_endpointPositiveScreenFailureEvent
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ)
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (j : ℕ)
    (hendpoints :
      ∀ r, r ∈ indexSet j →
        a j r ∈ Finset.Icc (lo j) (hi j) ∧
          b j r ∈ Finset.Icc (lo j) (hi j)) :
    blockFailure lo hi M j ⊆
      endpointPositiveScreenFailureEvent indexSet a b M j := by
  intro omega hfail r hr hpair
  rcases hendpoints r hr with ⟨ha, hb⟩
  have hblock :
      omega ∈ {omega | blockSuccess lo hi M omega j} :=
    endpointPositivePairSuccess_subset_blockSuccess lo hi M (a j r) (b j r) j
      ha hb hpair
  exact hfail hblock

/-- Probability of positive block failure is bounded by the probability that
all positive endpoint-pair screens fail. -/
theorem measure_blockFailure_le_endpointPositiveScreenFailureEvent
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ)
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (j : ℕ)
    (hendpoints :
      ∀ r, r ∈ indexSet j →
        a j r ∈ Finset.Icc (lo j) (hi j) ∧
          b j r ∈ Finset.Icc (lo j) (hi j)) :
    mu (blockFailure lo hi M j) ≤
      mu (endpointPositiveScreenFailureEvent indexSet a b M j) :=
  measure_mono
    (blockFailure_subset_endpointPositiveScreenFailureEvent
      lo hi M indexSet a b j hendpoints)

/-- Direct positive-screen certificate.  Use this if the analytic screen
piercing is proved one-sided from the start, avoiding the separate sign
adapter needed by the absolute endpoint-separation route. -/
structure EndpointSeparationDirectPositiveScreenCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  fail : ℕ → ℝ≥0∞
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  fail_summable : (∑' j, fail j) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  prob_screen_failure :
    ∀ j, mu (endpointPositiveScreenFailureEvent indexSet a b M j) ≤ fail j

/-- Direct positive-screen certificates produce positive block certificates. -/
noncomputable def positiveBlockOmega_of_endpointSeparationDirectPositiveScreenCertificate
    (h : EndpointSeparationDirectPositiveScreenCertificate) :
    PositiveBlockOmega where
  X := h.lo
  Y := h.hi
  M := h.M
  fail := h.fail
  X_tendsto := h.lo_tendsto_atTop
  M_tendsto := h.M_tendsto_atTop
  fail_summable := h.fail_summable
  prob_fail := by
    intro j
    calc
      mu (blockFailure h.lo h.hi h.M j)
          ≤ mu (endpointPositiveScreenFailureEvent h.indexSet h.a h.b h.M j) := by
            exact
              measure_blockFailure_le_endpointPositiveScreenFailureEvent
                h.lo h.hi h.M h.indexSet h.a h.b j
                (fun r hr => h.endpoints_in_block j r hr)
      _ ≤ h.fail j := h.prob_screen_failure j

/-- Direct final handoff for one-sided positive endpoint screens. -/
theorem erdos1144_of_endpointSeparationDirectPositiveScreenCertificate
    (h : EndpointSeparationDirectPositiveScreenCertificate) :
    Erdos1144 :=
  erdos1144_of_positiveBlockOmega
    (positiveBlockOmega_of_endpointSeparationDirectPositiveScreenCertificate h)

/-- Count-moment version of the direct positive endpoint-screen certificate.
This avoids the sign adapter when the analytic theorem directly controls the
number of positive endpoint-pair screen piercings. -/
structure EndpointSeparationDirectPositiveScreenCountCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  countMean : ℕ → ℝ
  countSecond : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  fail_summable :
    (∑' j, ENNReal.ofReal (4 * countSecond j / countMean j ^ 2)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  count_centered_second_integrable :
    ∀ j,
      Integrable
        (fun omega =>
          (endpointPositivePairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointPositivePairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2)
        mu
  count_mean_lower :
    ∀ j,
      countMean j ≤
        ∫ omega, endpointPositivePairSuccessCountReal indexSet a b M j omega ∂mu
  count_centered_second_upper :
    ∀ j,
      (∫ omega,
          (endpointPositivePairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointPositivePairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2 ∂mu)
        ≤ countSecond j

/-- Count-moment direct-positive screen certificates specialize to the direct
all-positive-screens-fail certificate. -/
noncomputable def endpointSeparationDirectPositiveScreenCertificate_of_count
    (h : EndpointSeparationDirectPositiveScreenCountCertificate) :
    EndpointSeparationDirectPositiveScreenCertificate where
