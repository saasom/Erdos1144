/-- Direct final handoff for one-sided pierced positive endpoint screens with
ordinary real summable failure probabilities. -/
theorem erdos1144_of_endpointSeparationDirectPositivePiercedScreenRealSummableCertificate
    (h : EndpointSeparationDirectPositivePiercedScreenRealSummableCertificate) :
    Erdos1144 :=
  erdos1144_of_endpointSeparationDirectPositivePiercedScreenCertificate
    (endpointSeparationDirectPositivePiercedScreenCertificate_of_realSummable h)

/-- All endpoint-pair screens in a block fail to be pierced.  This is the
block-level event paid by the Harperized increment cloud: every candidate
dyadic increment remains inside its deterministic endpoint screen. -/
def endpointAbsScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) : Set Omega :=
  {omega |
    ∀ r, r ∈ indexSet j →
      omega ∉
        endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)}

/-- The complement of absolute screen failure is the event that at least one
absolute endpoint-pair screen is pierced. -/
theorem endpointAbsScreenFailureEvent_compl_eq_exists_pairSuccess
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (endpointAbsScreenFailureEvent indexSet a b M j)ᶜ =
      {omega |
        ∃ r, r ∈ indexSet j ∧
          omega ∈
            endpointAbsPairSuccessEvent
              (fun N omega => normSum omega N) (M j) (a j r) (b j r)} := by
  ext omega
  simp [endpointAbsScreenFailureEvent]

/-- A single pierced absolute endpoint-pair screen rules out the all-screens-fail
event. -/
theorem endpointAbsPairSuccess_subset_endpointAbsScreenFailureEvent_compl
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j r : ℕ) (hr : r ∈ indexSet j) :
    endpointAbsPairSuccessEvent
        (fun N omega => normSum omega N) (M j) (a j r) (b j r) ⊆
      (endpointAbsScreenFailureEvent indexSet a b M j)ᶜ := by
  intro omega hpair hfail
  exact hfail r hr hpair

/-- The absolute all-screens-fail event is measurable. -/
theorem measurableSet_endpointAbsScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    MeasurableSet (endpointAbsScreenFailureEvent indexSet a b M j) := by
  rw [show endpointAbsScreenFailureEvent indexSet a b M j =
      ⋂ r, if r ∈ indexSet j then
        (endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r))ᶜ
      else Set.univ by
        ext omega
        simp [endpointAbsScreenFailureEvent]]
  exact MeasurableSet.iInter fun r => by
    by_cases hr : r ∈ indexSet j
    · simp [hr, (measurableSet_endpointAbsPairSuccessEvent
        (M j) (a j r) (b j r)).compl]
    · simp [hr]

/-- If the pierced-absolute-screen event has real probability at least
`1 - delta`, then the all-absolute-screens-fail event has `ENNReal` probability
at most `delta`. -/
theorem measure_endpointAbsScreenFailureEvent_le_of_exists_pairSuccess_measureReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (delta : ℝ)
    (hpierce :
      1 - delta ≤
        mu.real
          {omega |
            ∃ r, r ∈ indexSet j ∧
              omega ∈
                endpointAbsPairSuccessEvent
                  (fun N omega => normSum omega N) (M j) (a j r) (b j r)}) :
    mu (endpointAbsScreenFailureEvent indexSet a b M j) ≤
      ENNReal.ofReal delta := by
  let F := endpointAbsScreenFailureEvent indexSet a b M j
  have hcompl_lower : 1 - delta ≤ mu.real Fᶜ := by
    simpa [F, endpointAbsScreenFailureEvent_compl_eq_exists_pairSuccess]
      using hpierce
  have hle : mu (Fᶜ)ᶜ ≤ ENNReal.ofReal delta :=
    measure_compl_le_of_measureReal_ge_one_sub Fᶜ delta
      (measurableSet_endpointAbsScreenFailureEvent indexSet a b M j).compl
      hcompl_lower
  simpa [F] using hle

/-- Real-valued count of pierced absolute endpoint-pair screens in one block. -/
noncomputable def endpointAbsPairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) : ℝ := by
  classical
  exact
    (((indexSet j).filter fun r =>
      omega ∈
        endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)).card : ℝ)

/-- Pointwise expansion of the absolute endpoint-pair count as a finite sum of
event indicators. -/
theorem endpointAbsPairSuccessCountReal_eq_sum_indicator
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) :
    endpointAbsPairSuccessCountReal indexSet a b M j omega =
      ∑ r ∈ indexSet j,
        (endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)).indicator
          (fun _ : Omega => (1 : ℝ)) omega := by
  classical
  unfold endpointAbsPairSuccessCountReal
  rw [Finset.card_filter]
  rw [Nat.cast_sum]
  refine Finset.sum_congr rfl fun r hr => ?_
  by_cases hpair :
      omega ∈
        endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)
  · simp [hpair]
  · simp [hpair]

/-- Two absolute endpoint-pair screens are pierced simultaneously. -/
def endpointAbsPairScreenJointSuccessEvent
    (M : ℕ → ℝ) (a b : ℕ → ℕ → ℕ) (j r s : ℕ) : Set Omega :=
  endpointAbsPairSuccessEvent
      (fun N omega => normSum omega N) (M j) (a j r) (b j r) ∩
    endpointAbsPairSuccessEvent
      (fun N omega => normSum omega N) (M j) (a j s) (b j s)

/-- Measurability of the joint absolute endpoint-pair screen event. -/
theorem measurableSet_endpointAbsPairScreenJointSuccessEvent
    (M : ℕ → ℝ) (a b : ℕ → ℕ → ℕ) (j r s : ℕ) :
    MeasurableSet (endpointAbsPairScreenJointSuccessEvent M a b j r s) := by
  exact
    (measurableSet_endpointAbsPairSuccessEvent (M j) (a j r) (b j r)).inter
      (measurableSet_endpointAbsPairSuccessEvent (M j) (a j s) (b j s))

/-- The pointwise square of the absolute endpoint-pair count expands into the
double sum of joint-screen indicators. -/
theorem endpointAbsPairSuccessCountReal_sq_eq_sum_joint_indicator
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (omega : Omega) :
    (endpointAbsPairSuccessCountReal indexSet a b M j omega) ^ 2 =
      ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
        (endpointAbsPairScreenJointSuccessEvent M a b j r s).indicator
          (fun _ : Omega => (1 : ℝ)) omega := by
  classical
  rw [endpointAbsPairSuccessCountReal_eq_sum_indicator]
  rw [pow_two, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun r hr => ?_
  refine Finset.sum_congr rfl fun s hs => ?_
  by_cases hrω :
      omega ∈
        endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)
  · by_cases hsω :
        omega ∈
          endpointAbsPairSuccessEvent
            (fun N omega => normSum omega N) (M j) (a j s) (b j s)
    · simp [endpointAbsPairScreenJointSuccessEvent, hrω, hsω]
    · simp [endpointAbsPairScreenJointSuccessEvent, hrω, hsω]
  · simp [endpointAbsPairScreenJointSuccessEvent, hrω]

/-- The absolute endpoint-pair count is integrable. -/
theorem integrable_endpointAbsPairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    Integrable (endpointAbsPairSuccessCountReal indexSet a b M j) mu := by
  classical
  rw [show endpointAbsPairSuccessCountReal indexSet a b M j =
      fun omega =>
        ∑ r ∈ indexSet j,
          (endpointAbsPairSuccessEvent
            (fun N omega => normSum omega N) (M j) (a j r) (b j r)).indicator
            (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointAbsPairSuccessCountReal_eq_sum_indicator indexSet a b M j omega]
  refine integrable_finset_sum (indexSet j) ?_
  intro r _hr
  exact
    (integrable_const (1 : ℝ)).indicator
      (measurableSet_endpointAbsPairSuccessEvent (M j) (a j r) (b j r))

/-- The square of the absolute endpoint-pair count is integrable. -/
theorem integrable_endpointAbsPairSuccessCountReal_sq
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    Integrable
      (fun omega => (endpointAbsPairSuccessCountReal indexSet a b M j omega) ^ 2)
      mu := by
  classical
  rw [show
      (fun omega =>
        (endpointAbsPairSuccessCountReal indexSet a b M j omega) ^ 2) =
        fun omega =>
          ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
            (endpointAbsPairScreenJointSuccessEvent M a b j r s).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointAbsPairSuccessCountReal_sq_eq_sum_joint_indicator
          indexSet a b M j omega]
  refine integrable_finset_sum (indexSet j) ?_
  intro r _hr
  refine integrable_finset_sum (indexSet j) ?_
  intro s _hs
  exact
    (integrable_const (1 : ℝ)).indicator
      (measurableSet_endpointAbsPairScreenJointSuccessEvent M a b j r s)

/-- First-moment identity for the absolute endpoint-pair screen count. -/
theorem integral_endpointAbsPairSuccessCountReal
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (∫ omega, endpointAbsPairSuccessCountReal indexSet a b M j omega ∂mu)
      =
    ∑ r ∈ indexSet j,
      mu.real
        (endpointAbsPairSuccessEvent
          (fun N omega => normSum omega N) (M j) (a j r) (b j r)) := by
  classical
  rw [show
      (fun omega => endpointAbsPairSuccessCountReal indexSet a b M j omega) =
        fun omega =>
          ∑ r ∈ indexSet j,
            (endpointAbsPairSuccessEvent
              (fun N omega => normSum omega N) (M j) (a j r) (b j r)).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointAbsPairSuccessCountReal_eq_sum_indicator indexSet a b M j omega]
  rw [integral_finset_sum]
  · refine Finset.sum_congr rfl fun r _hr => ?_
    exact
      MeasureTheory.integral_indicator_one
        (measurableSet_endpointAbsPairSuccessEvent (M j) (a j r) (b j r))
  · intro r _hr
    exact
      (integrable_const (1 : ℝ)).indicator
        (measurableSet_endpointAbsPairSuccessEvent (M j) (a j r) (b j r))

/-- Raw second-moment identity for the absolute endpoint-pair screen count. -/
theorem integral_endpointAbsPairSuccessCountReal_sq
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    (∫ omega, (endpointAbsPairSuccessCountReal indexSet a b M j omega) ^ 2 ∂mu)
      =
    ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
      mu.real (endpointAbsPairScreenJointSuccessEvent M a b j r s) := by
  classical
  rw [show
      (fun omega =>
        (endpointAbsPairSuccessCountReal indexSet a b M j omega) ^ 2) =
        fun omega =>
          ∑ r ∈ indexSet j, ∑ s ∈ indexSet j,
            (endpointAbsPairScreenJointSuccessEvent M a b j r s).indicator
              (fun _ : Omega => (1 : ℝ)) omega by
        funext omega
        exact endpointAbsPairSuccessCountReal_sq_eq_sum_joint_indicator
          indexSet a b M j omega]
  rw [integral_finset_sum]
  · refine Finset.sum_congr rfl fun r _hr => ?_
    rw [integral_finset_sum]
    · refine Finset.sum_congr rfl fun s _hs => ?_
      exact
        MeasureTheory.integral_indicator_one
          (measurableSet_endpointAbsPairScreenJointSuccessEvent M a b j r s)
    · intro s _hs
      exact
        (integrable_const (1 : ℝ)).indicator
          (measurableSet_endpointAbsPairScreenJointSuccessEvent M a b j r s)
  · intro r _hr
    refine integrable_finset_sum (indexSet j) ?_
    intro s _hs
    exact
      (integrable_const (1 : ℝ)).indicator
        (measurableSet_endpointAbsPairScreenJointSuccessEvent M a b j r s)

/-- If all absolute screens fail, then the pierced-screen count is zero and in
particular below half of any positive target mean. -/
theorem endpointAbsScreenFailureEvent_subset_count_lt_half
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (m : ℝ) (hm : 0 < m) :
    endpointAbsScreenFailureEvent indexSet a b M j ⊆
      {omega | endpointAbsPairSuccessCountReal indexSet a b M j omega < m / 2} := by
  classical
  intro omega hfail
  have hfilter :
      ((indexSet j).filter fun r =>
        omega ∈
          endpointAbsPairSuccessEvent
            (fun N omega => normSum omega N) (M j) (a j r) (b j r)) = ∅ := by
    ext r
    constructor
    · intro hr
      rw [Finset.mem_filter] at hr
      exact (hfail r hr.1 hr.2).elim
    · intro hr
      simp at hr
  have hcount :
      endpointAbsPairSuccessCountReal indexSet a b M j omega = 0 := by
    unfold endpointAbsPairSuccessCountReal
    rw [hfilter]
    simp
  change endpointAbsPairSuccessCountReal indexSet a b M j omega < m / 2
  rw [hcount]
  linarith

/-- A centered second-moment estimate for the pierced endpoint-pair count pays
the absolute all-screens-fail event. -/
theorem measure_endpointAbsScreenFailureEvent_le_count_second
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) (countMean countSecond : ℝ)
    (hmean_pos : 0 < countMean)
    (hsecond_int :
      Integrable
        (fun omega =>
          (endpointAbsPairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointAbsPairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2)
        mu)
    (hmean :
      countMean ≤
        ∫ omega, endpointAbsPairSuccessCountReal indexSet a b M j omega ∂mu)
    (hsecond :
      (∫ omega,
          (endpointAbsPairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointAbsPairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2 ∂mu)
        ≤ countSecond) :
    mu (endpointAbsScreenFailureEvent indexSet a b M j) ≤
      ENNReal.ofReal (4 * countSecond / countMean ^ 2) := by
  calc
    mu (endpointAbsScreenFailureEvent indexSet a b M j)
        ≤ mu
            {omega |
              endpointAbsPairSuccessCountReal indexSet a b M j omega <
                countMean / 2} :=
          measure_mono
            (endpointAbsScreenFailureEvent_subset_count_lt_half
              indexSet a b M j countMean hmean_pos)
    _ ≤ ENNReal.ofReal (4 * countSecond / countMean ^ 2) :=
          measure_lt_half_mean_le_centered_second
            (endpointAbsPairSuccessCountReal indexSet a b M j)
            countMean countSecond hmean_pos hsecond_int hmean hsecond

/-- Absolute screen failure implies positive screen failure.  Thus proving
positive screens directly is a strictly stronger one-sided input than proving
absolute screens. -/
theorem endpointAbsScreenFailureEvent_subset_endpointPositiveScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    endpointAbsScreenFailureEvent indexSet a b M j ⊆
      endpointPositiveScreenFailureEvent indexSet a b M j := by
  intro omega hfail r hr hpos
  exact hfail r hr
    (endpointPositivePairSuccess_subset_endpointAbsPairSuccess
      (M j) (a j r) (b j r) hpos)

/-- Measure form of
`endpointAbsScreenFailureEvent_subset_endpointPositiveScreenFailureEvent`. -/
theorem measure_endpointAbsScreenFailureEvent_le_endpointPositiveScreenFailureEvent
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (M : ℕ → ℝ)
    (j : ℕ) :
    mu (endpointAbsScreenFailureEvent indexSet a b M j) ≤
      mu (endpointPositiveScreenFailureEvent indexSet a b M j) :=
  measure_mono
    (endpointAbsScreenFailureEvent_subset_endpointPositiveScreenFailureEvent
      indexSet a b M j)

/-- If both endpoints of every candidate pair lie in the raw block, then raw
absolute block failure forces all endpoint-pair screens to fail. -/
theorem absBlockFailure_subset_endpointAbsScreenFailureEvent
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ)
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (j : ℕ)
    (hendpoints :
      ∀ r, r ∈ indexSet j →
        a j r ∈ Finset.Icc (lo j) (hi j) ∧
          b j r ∈ Finset.Icc (lo j) (hi j)) :
    absBlockFailure lo hi M j ⊆
      endpointAbsScreenFailureEvent indexSet a b M j := by
  intro omega hfail r hr hpair
  rcases hendpoints r hr with ⟨ha, hb⟩
  have habs :
      omega ∈ {omega | absBlockSuccess lo hi M omega j} :=
    endpointAbsPairSuccess_subset_absBlockSuccess lo hi M (a j r) (b j r) j ha hb
      hpair
  exact hfail habs

/-- Probability of absolute block failure is bounded by the probability that
all endpoint-pair screens fail. -/
theorem measure_absBlockFailure_le_endpointAbsScreenFailureEvent
    (lo hi : ℕ → ℕ) (M : ℕ → ℝ)
    (indexSet : ℕ → Finset ℕ) (a b : ℕ → ℕ → ℕ) (j : ℕ)
    (hendpoints :
      ∀ r, r ∈ indexSet j →
        a j r ∈ Finset.Icc (lo j) (hi j) ∧
          b j r ∈ Finset.Icc (lo j) (hi j)) :
    mu (absBlockFailure lo hi M j) ≤
      mu (endpointAbsScreenFailureEvent indexSet a b M j) :=
  measure_mono
    (absBlockFailure_subset_endpointAbsScreenFailureEvent
      lo hi M indexSet a b j hendpoints)

/-- Lean-facing certificate for the Harperized endpoint-increment screen
route.  The hard analytic input is the `prob_screen_failure` field: after
conditioning, critical-variance fresh walks, covariance pruning, and Gaussian
screen-piercing make the event that all candidate endpoint screens survive
summably unlikely. -/
structure EndpointSeparationAbsScreenCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  fail : ℕ → ℝ≥0∞
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  fail_summable : (∑' j, fail j) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  prob_screen_failure :
    ∀ j, mu (endpointAbsScreenFailureEvent indexSet a b M j) ≤ fail j

/-- Count-moment version of the absolute endpoint-screen certificate.  This is
useful when the many-trial analytic theorem is stated as a lower bound for the
expected number of pierced endpoint pairs plus a centered second-moment
estimate. -/
structure EndpointSeparationAbsScreenCountCertificate where
  lo : ℕ → ℕ
  hi : ℕ → ℕ
  M : ℕ → ℝ
  indexSet : ℕ → Finset ℕ
  a : ℕ → ℕ → ℕ
  b : ℕ → ℕ → ℕ
  countMean : ℕ → ℝ
  countSecond : ℕ → ℝ
  lo_tendsto_atTop : Tendsto lo atTop atTop
  M_tendsto_atTop : Tendsto M atTop atTop
  countMean_pos : ∀ j, 0 < countMean j
  fail_summable :
    (∑' j, ENNReal.ofReal (4 * countSecond j / countMean j ^ 2)) ≠ ⊤
  endpoints_in_block :
    ∀ j r, r ∈ indexSet j →
      a j r ∈ Finset.Icc (lo j) (hi j) ∧
        b j r ∈ Finset.Icc (lo j) (hi j)
  count_centered_second_integrable :
    ∀ j,
      Integrable
        (fun omega =>
          (endpointAbsPairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointAbsPairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2)
        mu
  count_mean_lower :
    ∀ j,
      countMean j ≤
        ∫ omega, endpointAbsPairSuccessCountReal indexSet a b M j omega ∂mu
  count_centered_second_upper :
    ∀ j,
      (∫ omega,
          (endpointAbsPairSuccessCountReal indexSet a b M j omega -
            ∫ omega',
              endpointAbsPairSuccessCountReal indexSet a b M j omega' ∂mu) ^ 2 ∂mu)
        ≤ countSecond j

/-- Count-moment endpoint-screen certificates specialize to the direct
all-screens-fail certificate. -/
noncomputable def endpointSeparationAbsScreenCertificate_of_count
    (h : EndpointSeparationAbsScreenCountCertificate) :
    EndpointSeparationAbsScreenCertificate where
  lo := h.lo
  hi := h.hi
  M := h.M
  indexSet := h.indexSet
  a := h.a
  b := h.b
  fail := fun j => ENNReal.ofReal (4 * h.countSecond j / h.countMean j ^ 2)
  lo_tendsto_atTop := h.lo_tendsto_atTop
  M_tendsto_atTop := h.M_tendsto_atTop
  fail_summable := h.fail_summable
  endpoints_in_block := h.endpoints_in_block
  prob_screen_failure := by
    intro j
    exact
      measure_endpointAbsScreenFailureEvent_le_count_second
        h.indexSet h.a h.b h.M j (h.countMean j) (h.countSecond j)
        (h.countMean_pos j) (h.count_centered_second_integrable j)
        (h.count_mean_lower j) (h.count_centered_second_upper j)

/-- Endpoint-screen certificates produce absolute block certificates. -/
noncomputable def absBlockOmega_of_endpointSeparationAbsScreenCertificate
    (h : EndpointSeparationAbsScreenCertificate) :
    AbsBlockOmega where
  X := h.lo
  Y := h.hi
  M := h.M
  fail := h.fail
  X_tendsto := h.lo_tendsto_atTop
  M_tendsto := h.M_tendsto_atTop
  fail_summable := h.fail_summable
  prob_fail := by
    intro j
    calc
      mu (absBlockFailure h.lo h.hi h.M j)
          ≤ mu (endpointAbsScreenFailureEvent h.indexSet h.a h.b h.M j) := by
            exact
              measure_absBlockFailure_le_endpointAbsScreenFailureEvent
                h.lo h.hi h.M h.indexSet h.a h.b j
                (fun r hr => h.endpoints_in_block j r hr)
      _ ≤ h.fail j := h.prob_screen_failure j

/-- Direct closure of the absolute target from a Harperized endpoint-screen
certificate.  This is intentionally an absolute-value conclusion; converting it
to the current one-sided `Erdos1144` target remains a separate sign/target
adapter. -/
theorem absErdos1144_of_endpointSeparationAbsScreenCertificate
    (h : EndpointSeparationAbsScreenCertificate) :
    AbsErdos1144 :=
  absErdos1144_of_absBlockOmega
    (absBlockOmega_of_endpointSeparationAbsScreenCertificate h)

/-- Direct closure of the absolute target from count-moment endpoint screens. -/
theorem absErdos1144_of_endpointSeparationAbsScreenCountCertificate
    (h : EndpointSeparationAbsScreenCountCertificate) :
    AbsErdos1144 :=
  absErdos1144_of_endpointSeparationAbsScreenCertificate
    (endpointSeparationAbsScreenCertificate_of_count h)

