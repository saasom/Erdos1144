  exact
    measureReal_endpointAbsPairSuccess_lower_of_second_fourth_zero_remainder
      X lambda M T U a b A Z V K hZmeas hV hK hdecomp hT hM
      (measureReal_shiftedFreshLarge_eq_reflected_of_measurePreserving
        A Z U tau htau hA hZflip)
      hU_sq hZsecond_int hZfourth_int hZsecond hZfourth

/-- Endpoint absolute-success lower bound specialized to a finite fresh
Rademacher linear form and an `L^2` remainder budget.  The finite-walk
variance and fourth moment are discharged in Lean, leaving the paper side with
only the decomposition, reflection, threshold, variance-positivity, and
remainder-second-moment fields. -/
theorem measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_of_measurePreserving
    (X : ℕ → Omega → ℝ) (lambda M T U eps : ℝ) (a b : ℕ)
    (A R : Omega → ℝ) (s : Finset ℕ) (coeff : ℕ → ℝ)
    (second : ℝ) (tau : Omega → Omega)
    (hV : 0 < ∑ p ∈ s, coeff p ^ 2)
    (heps : 0 < eps)
    (hdecomp :
      ∀ omega,
        endpointSeparationValue X lambda a b omega =
          A omega + epsLinearForm s coeff omega + R omega)
    (hT : T ≤ U - eps)
    (hM : (1 + |lambda|) * M < T)
    (htau : MeasurePreserving tau mu mu)
    (hA : ∀ omega, A (tau omega) = A omega)
    (hZflip : ∀ omega,
      epsLinearForm s coeff (tau omega) = -epsLinearForm s coeff omega)
    (hU_sq : U ^ 2 ≤ (∑ p ∈ s, coeff p ^ 2) / 2)
    (hRsecond_int : Integrable (fun omega => (R omega) ^ 2) mu)
    (hRsecond : (∫ omega, (R omega) ^ 2 ∂mu) ≤ second) :
    (1 : ℝ) / 24 - second / eps ^ 2 ≤
      mu.real (endpointAbsPairSuccessEvent X M a b) := by
  have h :=
    measureReal_endpointAbsPairSuccess_lower_of_second_fourth_of_measurePreserving
      X lambda M T U eps a b A (epsLinearForm s coeff) R
      (∑ p ∈ s, coeff p ^ 2) 3 second tau
      (measurable_epsLinearForm s coeff)
      hV
      (by norm_num : (0 : ℝ) < 3)
      heps
      hdecomp
      hT
      hM
      htau
      hA
      hZflip
      hU_sq
      (integrable_epsLinearForm_sq s coeff)
      (integrable_epsLinearForm_fourth s coeff)
      (by rw [integral_epsLinearForm_sq_eq_sum_sq])
      (integral_epsLinearForm_fourth_le_three_sum_sq_sq s coeff)
      hRsecond_int
      hRsecond
  norm_num at h ⊢
  exact h

/-- Endpoint absolute-success lower bound specialized to a finite fresh
