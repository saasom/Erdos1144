/-- Exact-increment endpoint absolute-success lower bound specialized to a
finite fresh Rademacher linear form.  This is the clean one-block endpoint
screen interface when the decomposition has no residue. -/
theorem
    measureReal_endpointAbsPairSuccess_lower_of_epsLinearForm_zero_remainder_of_measurePreserving
    (X : ℕ → Omega → ℝ) (lambda M T U : ℝ) (a b : ℕ)
    (A : Omega → ℝ) (s : Finset ℕ) (coeff : ℕ → ℝ) (tau : Omega → Omega)
