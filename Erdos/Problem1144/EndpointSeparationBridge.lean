import Mathlib.Probability.Independence.ZeroOne
import Erdos.Problem1144.HarperTrackB
import Erdos.Problem1144.HarperAbundance
import Erdos.Problem1144.HarperIncrementOneSidedBridge
import Erdos.Problem1144.RademacherConcentration

open MeasureTheory Filter
open scoped BigOperators ENNReal Topology

namespace Erdos
namespace Problem1144

/-!
## Endpoint-separation bridge

This file isolates the bridge suggested by the endpoint-separation route:
large fresh energy should force a large raw endpoint difference, and a large
endpoint difference forces at least one raw endpoint to be large in absolute
value.

This deliberately proves an absolute-value target.  The current `Erdos1144`
statement in `Targets.lean` is one-sided positive, so this module is not wired
into `Final.lean`.
-/

/-- Absolute-value version of the current target. -/
def AbsErdos1144 : Prop :=
  ∀ᵐ omega ∂mu, ∀ A : ℝ, ∃ᶠ N : ℕ in atTop, A ≤ |normSum omega N|

/-- Negative one-sided analogue of the current target. -/
def NegativeErdos1144 : Prop :=
  ∀ᵐ omega ∂mu, ∀ A : ℝ, ∃ᶠ N : ℕ in atTop, A ≤ -normSum omega N

/-- Pointwise positive one-sided target. -/
def positiveErdos1144Point (omega : Omega) : Prop :=
  ∀ A : ℝ, ∃ᶠ N : ℕ in atTop, A ≤ normSum omega N

/-- Pointwise negative one-sided target. -/
def negativeErdos1144Point (omega : Omega) : Prop :=
  ∀ A : ℝ, ∃ᶠ N : ℕ in atTop, A ≤ -normSum omega N

/-- Pointwise absolute target. -/
def absErdos1144Point (omega : Omega) : Prop :=
  ∀ A : ℝ, ∃ᶠ N : ℕ in atTop, A ≤ |normSum omega N|

/-- Event form of the pointwise positive one-sided target.  This is useful for
packaging the remaining zero-one input as a set-level probability statement. -/
def positiveErdos1144Event : Set Omega :=
  {omega | positiveErdos1144Point omega}

/-- Event form of the pointwise negative one-sided target. -/
def negativeErdos1144Event : Set Omega :=
  {omega | negativeErdos1144Point omega}

/-- The positive one-sided point event is measurable.  The proof rewrites the
real-threshold frequent event as a countable intersection over natural
thresholds and starting indices. -/
theorem measurableSet_positiveErdos1144Event :
    MeasurableSet positiveErdos1144Event := by
  rw [show positiveErdos1144Event =
      ⋂ k : ℕ, ⋂ n0 : ℕ,
        ⋃ N : ℕ, {omega : Omega | n0 ≤ N ∧ (k : ℝ) ≤ normSum omega N} by
    ext omega
    simp only [positiveErdos1144Event, Set.mem_setOf_eq, Set.mem_iInter,
      Set.mem_iUnion]
    constructor
    · intro h k n0
      rcases (frequently_atTop.mp (h k)) n0 with ⟨N, hN_ge, hN⟩
      exact ⟨N, hN_ge, hN⟩
    · intro h A
      rcases exists_nat_ge A with ⟨k, hAk⟩
      rw [frequently_atTop]
      intro n0
      rcases h k n0 with ⟨N, hN_ge, hN⟩
      exact ⟨N, hN_ge, le_trans hAk hN⟩]
  refine MeasurableSet.iInter fun k => MeasurableSet.iInter fun n0 =>
    MeasurableSet.iUnion fun N => ?_
  by_cases hN : n0 ≤ N
  · simpa [hN] using measurableSet_le measurable_const (measurable_normSum N)
  · simp [hN]

/-- The negative one-sided point event is measurable, by the same countable
threshold/start-index reduction as the positive event. -/
theorem measurableSet_negativeErdos1144Event :
    MeasurableSet negativeErdos1144Event := by
  rw [show negativeErdos1144Event =
      ⋂ k : ℕ, ⋂ n0 : ℕ,
        ⋃ N : ℕ, {omega : Omega | n0 ≤ N ∧ (k : ℝ) ≤ -normSum omega N} by
    ext omega
    simp only [negativeErdos1144Event, Set.mem_setOf_eq, Set.mem_iInter,
      Set.mem_iUnion]
    constructor
    · intro h k n0
      rcases (frequently_atTop.mp (h k)) n0 with ⟨N, hN_ge, hN⟩
      exact ⟨N, hN_ge, hN⟩
    · intro h A
      rcases exists_nat_ge A with ⟨k, hAk⟩
      rw [frequently_atTop]
      intro n0
      rcases h k n0 with ⟨N, hN_ge, hN⟩
      exact ⟨N, hN_ge, le_trans hAk hN⟩]
  refine MeasurableSet.iInter fun k => MeasurableSet.iInter fun n0 =>
    MeasurableSet.iUnion fun N => ?_
  by_cases hN : n0 ≤ N
  · simpa [hN] using measurableSet_le measurable_const (measurable_normSum N).neg
  · simp [hN]

/-- Set-level zero-one certificate for the positive point event.  This is the
Lean-facing form of the remaining tail/zero-one law needed by the
endpoint-separation route. -/
structure PositiveErdos1144MeasureZeroOne where
  measure_zero_or_one : mu positiveErdos1144Event = 0 ∨ mu positiveErdos1144Event = 1

/-- Tail σ-algebra of the coordinate coin flips.  Kolmogorov's 0-1 law applies
to events measurable with respect to this σ-algebra. -/
abbrev coordinateTailMeasurableSpace : MeasurableSpace Omega :=
  limsup
    (fun n : ℕ => MeasurableSpace.comap (fun omega : Omega => omega n) inferInstance)
    atTop

/-- The coordinate σ-algebra generated by all coordinates from `n` onward. -/
abbrev coordinateTailFromMeasurableSpace (n : ℕ) : MeasurableSpace Omega :=
  ⨆ i : ℕ, ⨆ _hi : i ≥ n,
    MeasurableSpace.comap (fun omega : Omega => omega i) inferInstance

/-- Every coordinate from `n` onward is measurable with respect to the
tail-from-`n` coordinate σ-algebra. -/
theorem measurable_coordinateTailFrom_eval_of_ge (n i : ℕ) (hi : n ≤ i) :
    Measurable[coordinateTailFromMeasurableSpace n] fun omega : Omega => omega i := by
  intro t ht
  have hle :
      MeasurableSpace.comap (fun omega : Omega => omega i) inferInstance ≤
        coordinateTailFromMeasurableSpace n := by
    exact le_iSup_of_le i (le_iSup_of_le hi le_rfl)
  have hpre :
      MeasurableSet[MeasurableSpace.comap (fun omega : Omega => omega i) inferInstance]
        ((fun omega : Omega => omega i) ⁻¹' t) := by
    exact MeasurableSpace.measurableSet_comap.mpr ⟨t, ht, rfl⟩
  exact hle _ hpre

/-- Every Rademacher coordinate sign from `n` onward is measurable with
respect to the tail-from-`n` coordinate σ-algebra. -/
theorem measurable_coordinateTailFrom_eps_of_ge (n i : ℕ) (hi : n ≤ i) :
    Measurable[coordinateTailFromMeasurableSpace n] fun omega : Omega => eps omega i := by
  exact
    (measurable_of_finite boolSign).comp
      (measurable_coordinateTailFrom_eval_of_ge n i hi)

/-- A practical sufficient condition for coordinate-tail measurability: it is
enough to prove measurability with respect to every tail generated by
coordinates `i >= n`. -/
theorem measurableSet_coordinateTail_of_measurableSet_coordinateTailFrom
    (h : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event) :
    MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event := by
  rw [coordinateTailMeasurableSpace, Filter.limsup_eq_iInf_iSup_of_nat]
  exact MeasurableSpace.measurableSet_iInf.mpr h

/-- Coordinate-tail measurability of the positive event is enough for the
set-level zero-one input.  This keeps the remaining zero-one task honest: one
still has to prove the tail-measurability hypothesis, but no additional
probability theory is needed afterwards. -/
theorem positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTail
    (htail : MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event) :
    PositiveErdos1144MeasureZeroOne := by
  refine ⟨?_⟩
  refine ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
    (μ := mu) ?hle ?hindep htail
  · intro n
    exact (measurable_pi_apply n).comap_le
  · simpa [ProbabilityTheory.iIndepFun] using iIndepFun_coordinates

/-- Version of the zero-one wrapper using the concrete all-far-tail
measurability condition. -/
theorem positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTailFrom
    (h : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event) :
    PositiveErdos1144MeasureZeroOne :=
  positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTail
    (measurableSet_coordinateTail_of_measurableSet_coordinateTailFrom h)

/-- Set-level sign-symmetry certificate.  This is weaker to consume than a
concrete measure-preserving transformation: it only asks for equality of the
positive and negative point-event probabilities. -/
structure PositiveNegativeMeasureSymmetry where
  measure_eq : mu positiveErdos1144Event = mu negativeErdos1144Event

/-- Set-level sign-domination certificate.  This is the weakest probability
comparison needed by the absolute-to-positive adapter: if the positive event is
null, then the negative event is null as well. -/
structure PositiveNegativeMeasureDomination where
  negative_le_positive : mu negativeErdos1144Event ≤ mu positiveErdos1144Event

/-- Equality of the positive and negative point-event probabilities gives the
weaker domination input. -/
def positiveNegativeMeasureDomination_of_measureSymmetry
    (h : PositiveNegativeMeasureSymmetry) :
    PositiveNegativeMeasureDomination where
  negative_le_positive := by
    rw [← h.measure_eq]

/-- A set-level zero-one law for the positive target gives the almost-sure
disjunction consumed by the sign adapter. -/
theorem positive_zero_one_of_measure_zero_or_one
    (h : PositiveErdos1144MeasureZeroOne) :
    (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
      (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega) := by
  rcases h.measure_zero_or_one with hzero | hone
  · right
    have hnot_mem : ∀ᵐ omega ∂mu, omega ∉ positiveErdos1144Event :=
      measure_eq_zero_iff_ae_notMem.mp hzero
    filter_upwards [hnot_mem] with omega homega
    simpa [positiveErdos1144Event] using homega
  · left
    have hmem : positiveErdos1144Event ∈ ae mu :=
      (MeasureTheory.mem_ae_iff_prob_eq_one measurableSet_positiveErdos1144Event).mpr hone
    simpa [positiveErdos1144Event] using hmem

/-- A positive-probability proof of the positive target upgrades to almost-sure
positivity once the set-level zero-one law is available. -/
theorem positive_ae_of_measureZeroOne_of_measure_pos
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hpos : 0 < mu positiveErdos1144Event) :
    ∀ᵐ omega ∂mu, positiveErdos1144Point omega := by
  rcases hzero.measure_zero_or_one with hzero_measure | hone
  · rw [hzero_measure] at hpos
    exact (lt_irrefl (0 : ℝ≥0∞) hpos).elim
  · have hmem : positiveErdos1144Event ∈ ae mu :=
      (MeasureTheory.mem_ae_iff_prob_eq_one measurableSet_positiveErdos1144Event).mpr hone
    simpa [positiveErdos1144Event] using hmem

/-- Final one-sided handoff from a set-level zero-one law and positive
probability of the positive point event. -/
theorem erdos1144_of_measureZeroOne_of_positive_measure
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hpos : 0 < mu positiveErdos1144Event) :
    Erdos1144 := by
  simpa [Erdos1144, positiveErdos1144Point] using
    positive_ae_of_measureZeroOne_of_measure_pos hzero hpos

/-- Final one-sided handoff from coordinate-tail measurability of the positive
point event and positive probability of that event. -/
theorem erdos1144_of_coordinateTailMeasurable_of_positive_measure
    (htail : MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event)
    (hpos : 0 < mu positiveErdos1144Event) :
    Erdos1144 :=
  erdos1144_of_measureZeroOne_of_positive_measure
    (positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTail htail)
    hpos

/-- Final one-sided handoff from the concrete all-far-tail measurability
condition and positive probability of the positive point event. -/
theorem erdos1144_of_coordinateTailFromMeasurable_of_positive_measure
    (htail : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event)
    (hpos : 0 < mu positiveErdos1144Event) :
    Erdos1144 :=
  erdos1144_of_measureZeroOne_of_positive_measure
    (positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTailFrom htail)
    hpos

/-- Pointwise absolute unboundedness gives a positive-or-negative one-sided
alternative.  The choice of sign may depend on `omega`; turning the absolute
bridge into the current one-sided `Erdos1144` therefore still requires a
probabilistic sign/zero-one input. -/
theorem pointwise_absErdos1144_imp_positive_or_negative
    (omega : Omega)
    (habs : absErdos1144Point omega) :
    positiveErdos1144Point omega ∨ negativeErdos1144Point omega := by
  by_cases hpos : positiveErdos1144Point omega
  · exact Or.inl hpos
  · right
    rw [negativeErdos1144Point]
    rw [positiveErdos1144Point] at hpos
    rw [not_forall] at hpos
    rcases hpos with ⟨A0, hnot_freq⟩
    have hnot_eventually :
        ∀ᶠ N : ℕ in atTop, ¬ A0 ≤ normSum omega N :=
      not_frequently.mp hnot_freq
    intro B
    let C : ℝ := max (max A0 B) 1
    have hA0C : A0 ≤ C := by
      exact le_trans (le_max_left A0 B) (le_max_left (max A0 B) 1)
    have hBC : B ≤ C := by
      exact le_trans (le_max_right A0 B) (le_max_left (max A0 B) 1)
    exact
      ((habs C).and_eventually hnot_eventually).mono fun N hN => by
        rcases hN with ⟨habsN, hnotN⟩
        let x : ℝ := normSum omega N
        have hx_lt_A0 : x < A0 := lt_of_not_ge hnotN
        have hx_lt_C : x < C := lt_of_lt_of_le hx_lt_A0 hA0C
        have hx_neg : x < 0 := by
          by_contra hx_not_neg
          have hx_nonneg : 0 ≤ x := le_of_not_gt hx_not_neg
          have hx_abs : |x| = x := abs_of_nonneg hx_nonneg
          have hC_le_x : C ≤ x := by
            simpa [x, hx_abs] using habsN
          linarith
        have hC_le_neg : C ≤ -x := by
          simpa [x, abs_of_neg hx_neg] using habsN
        exact le_trans hBC hC_le_neg

/-- Almost-sure absolute unboundedness yields an almost-sure sign alternative.
This is the exact formal boundary left by the endpoint-separation route before
it can close the repository's one-sided `Erdos1144` target. -/
theorem absErdos1144_imp_positive_or_negative_ae
    (h : AbsErdos1144) :
    ∀ᵐ omega ∂mu, positiveErdos1144Point omega ∨ negativeErdos1144Point omega := by
  filter_upwards [h] with omega homega
  exact
    pointwise_absErdos1144_imp_positive_or_negative omega
      (by simpa [absErdos1144Point] using homega)

/-- Abstract probabilistic sign adapter for converting an absolute target into
the current positive one-sided target.  The `positive_zero_one` field is the
tail/zero-one input for the positive event.  The `negative_null_of_positive_null`
field is the sign-symmetry input: if the positive event is null, then the
negative event is null too. -/
structure AbsToPositiveSignAdapter where
  abs : AbsErdos1144
  positive_zero_one :
    (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
      (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega)
  negative_null_of_positive_null :
    (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega) →
      (∀ᵐ omega ∂mu, ¬ negativeErdos1144Point omega)

/-- A concrete sign-symmetry input: a measure-preserving transformation that
sends pointwise negative unboundedness to pointwise positive unboundedness. -/
structure PositiveNegativeSignSymmetry where
  transform : Omega → Omega
  measurePreserving : MeasurePreserving transform mu mu
  negative_imp_positive_transform :
    ∀ omega, negativeErdos1144Point omega →
      positiveErdos1144Point (transform omega)

/-- A measure-preserving sign symmetry turns positive nullity into negative
nullity. -/
theorem negative_null_of_positive_null_of_signSymmetry
    (h : PositiveNegativeSignSymmetry)
    (hpos_null : ∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega) :
    ∀ᵐ omega ∂mu, ¬ negativeErdos1144Point omega := by
  have hmap :
      ∀ᵐ omega ∂(mu.map h.transform), ¬ positiveErdos1144Point omega := by
    simpa [h.measurePreserving.map_eq] using hpos_null
  have hpull :
      ∀ᵐ omega ∂mu, ¬ positiveErdos1144Point (h.transform omega) :=
    MeasureTheory.ae_of_ae_map h.measurePreserving.aemeasurable hmap
  filter_upwards [hpull] with omega hpull hneg
  exact hpull (h.negative_imp_positive_transform omega hneg)

/-- Equality of positive and negative point-event probabilities is enough to
turn positive nullity into negative nullity. -/
theorem negative_null_of_positive_null_of_measureDomination
    (h : PositiveNegativeMeasureDomination)
    (hpos_null : ∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega) :
    ∀ᵐ omega ∂mu, ¬ negativeErdos1144Point omega := by
  have hpos_zero : mu positiveErdos1144Event = 0 := by
    rw [measure_eq_zero_iff_ae_notMem]
    filter_upwards [hpos_null] with omega homega
    simpa [positiveErdos1144Event] using homega
  have hneg_zero : mu negativeErdos1144Event = 0 := by
    exact le_antisymm (by simpa [hpos_zero] using h.negative_le_positive) (zero_le _)
  have hnot_mem : ∀ᵐ omega ∂mu, omega ∉ negativeErdos1144Event :=
    measure_eq_zero_iff_ae_notMem.mp hneg_zero
  filter_upwards [hnot_mem] with omega homega
  simpa [negativeErdos1144Event] using homega

/-- Equality of positive and negative point-event probabilities is enough to
turn positive nullity into negative nullity. -/
theorem negative_null_of_positive_null_of_measureSymmetry
    (h : PositiveNegativeMeasureSymmetry)
    (hpos_null : ∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega) :
    ∀ᵐ omega ∂mu, ¬ negativeErdos1144Point omega :=
  negative_null_of_positive_null_of_measureDomination
    (positiveNegativeMeasureDomination_of_measureSymmetry h)
    hpos_null

/-- Build the abstract sign adapter from absolute unboundedness, a zero-one law
for the positive event, and a concrete measure-preserving sign symmetry. -/
noncomputable def absToPositiveSignAdapter_of_signSymmetry
    (habs : AbsErdos1144)
    (hzero :
      (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
        (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega))
    (hsym : PositiveNegativeSignSymmetry) :
    AbsToPositiveSignAdapter where
  abs := habs
  positive_zero_one := hzero
  negative_null_of_positive_null :=
    negative_null_of_positive_null_of_signSymmetry hsym

/-- Build the abstract sign adapter from absolute unboundedness, a positive
zero-one law, and domination of the negative point-event probability by the
positive point-event probability. -/
noncomputable def absToPositiveSignAdapter_of_measureDomination
    (habs : AbsErdos1144)
    (hzero :
      (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
        (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega))
    (hdom : PositiveNegativeMeasureDomination) :
    AbsToPositiveSignAdapter where
  abs := habs
  positive_zero_one := hzero
  negative_null_of_positive_null :=
    negative_null_of_positive_null_of_measureDomination hdom

/-- Build the abstract sign adapter from absolute unboundedness, a positive
zero-one law, and equality of the positive and negative point-event
probabilities. -/
noncomputable def absToPositiveSignAdapter_of_measureSymmetry
    (habs : AbsErdos1144)
    (hzero :
      (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
        (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega))
    (hsym : PositiveNegativeMeasureSymmetry) :
    AbsToPositiveSignAdapter :=
  absToPositiveSignAdapter_of_measureDomination
    habs
    hzero
    (positiveNegativeMeasureDomination_of_measureSymmetry hsym)

/-- Build the abstract sign adapter from a set-level zero-one certificate and a
concrete measure-preserving sign symmetry. -/
noncomputable def absToPositiveSignAdapter_of_measureZeroOneSignSymmetry
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hsym : PositiveNegativeSignSymmetry) :
    AbsToPositiveSignAdapter :=
  absToPositiveSignAdapter_of_signSymmetry
    habs
    (positive_zero_one_of_measure_zero_or_one hzero)
    hsym

/-- Build the abstract sign adapter from set-level zero-one and measure-level
positive/negative domination. -/
noncomputable def absToPositiveSignAdapter_of_measureZeroOneMeasureDomination
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hdom : PositiveNegativeMeasureDomination) :
    AbsToPositiveSignAdapter :=
  absToPositiveSignAdapter_of_measureDomination
    habs
    (positive_zero_one_of_measure_zero_or_one hzero)
    hdom

/-- Build the abstract sign adapter from set-level zero-one and measure-level
positive/negative symmetry. -/
noncomputable def absToPositiveSignAdapter_of_measureZeroOneMeasureSymmetry
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hsym : PositiveNegativeMeasureSymmetry) :
    AbsToPositiveSignAdapter :=
  absToPositiveSignAdapter_of_measureZeroOneMeasureDomination
    habs
    hzero
    (positiveNegativeMeasureDomination_of_measureSymmetry hsym)

/-- Once the sign adapter is supplied, the endpoint-separation absolute target
is enough for the repository's one-sided `Erdos1144`. -/
theorem erdos1144_of_absToPositiveSignAdapter
    (h : AbsToPositiveSignAdapter) :
    Erdos1144 := by
  rcases h.positive_zero_one with hpos | hpos_null
  · simpa [Erdos1144, positiveErdos1144Point] using hpos
  · have hneg_null : ∀ᵐ omega ∂mu, ¬ negativeErdos1144Point omega :=
      h.negative_null_of_positive_null hpos_null
    have hsign : ∀ᵐ omega ∂mu,
        positiveErdos1144Point omega ∨ negativeErdos1144Point omega :=
      absErdos1144_imp_positive_or_negative_ae h.abs
    have hfalse : ∀ᵐ _omega ∂mu, False := by
      filter_upwards [hsign, hpos_null, hneg_null] with omega hpn hp hn
      exact hpn.elim hp hn
    have hbot : ae mu = ⊥ := eventually_false_iff_eq_bot.mp hfalse
    exact False.elim ((inferInstance : NeBot (ae mu)).ne hbot)

/-- Final one-sided handoff from absolute unboundedness once the positive
zero-one law and sign symmetry have been supplied. -/
theorem erdos1144_of_absErdos1144_of_signSymmetry
    (habs : AbsErdos1144)
    (hzero :
      (∀ᵐ omega ∂mu, positiveErdos1144Point omega) ∨
        (∀ᵐ omega ∂mu, ¬ positiveErdos1144Point omega))
    (hsym : PositiveNegativeSignSymmetry) :
    Erdos1144 :=
  erdos1144_of_absToPositiveSignAdapter
    (absToPositiveSignAdapter_of_signSymmetry habs hzero hsym)

/-- Final one-sided handoff from absolute unboundedness when the positive
zero-one law is supplied as a set-level probability statement. -/
theorem erdos1144_of_absErdos1144_of_measureZeroOneSignSymmetry
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hsym : PositiveNegativeSignSymmetry) :
    Erdos1144 :=
  erdos1144_of_absToPositiveSignAdapter
    (absToPositiveSignAdapter_of_measureZeroOneSignSymmetry habs hzero hsym)

/-- Final one-sided handoff from absolute unboundedness when the positive
zero-one law is set-level and the sign input is supplied as measure
domination. -/
theorem erdos1144_of_absErdos1144_of_measureZeroOneMeasureDomination
    (habs : AbsErdos1144)
    (hzero : PositiveErdos1144MeasureZeroOne)
    (hdom : PositiveNegativeMeasureDomination) :
    Erdos1144 :=
  erdos1144_of_absToPositiveSignAdapter
    (absToPositiveSignAdapter_of_measureZeroOneMeasureDomination habs hzero hdom)

/-- Final one-sided handoff from absolute unboundedness, coordinate-tail
measurability of the positive point event, and measure domination of the
negative event by the positive event. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailMeasureDomination
    (habs : AbsErdos1144)
    (htail : MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event)
    (hdom : PositiveNegativeMeasureDomination) :
    Erdos1144 :=
  erdos1144_of_absErdos1144_of_measureZeroOneMeasureDomination
    habs
    (positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTail htail)
    hdom

/-- Final one-sided handoff from absolute unboundedness, coordinate-tail
measurability of the positive point event, and equality of the positive and
negative point-event probabilities. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailMeasureSymmetry
    (habs : AbsErdos1144)
    (htail : MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event)
    (hsym : PositiveNegativeMeasureSymmetry) :
    Erdos1144 :=
  erdos1144_of_absErdos1144_of_coordinateTailMeasureDomination
    habs
    htail
    (positiveNegativeMeasureDomination_of_measureSymmetry hsym)

/-- Final one-sided handoff from absolute unboundedness, coordinate-tail
measurability of the positive point event, and a concrete sign symmetry. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailSignSymmetry
    (habs : AbsErdos1144)
    (htail : MeasurableSet[coordinateTailMeasurableSpace] positiveErdos1144Event)
    (hsym : PositiveNegativeSignSymmetry) :
    Erdos1144 :=
  erdos1144_of_absErdos1144_of_measureZeroOneSignSymmetry
    habs
    (positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTail htail)
    hsym

/-- Final one-sided handoff from absolute unboundedness, the concrete
all-far-tail measurability condition for the positive point event, and measure
domination of the negative event by the positive event. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailFromMeasureDomination
    (habs : AbsErdos1144)
    (htail : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event)
    (hdom : PositiveNegativeMeasureDomination) :
    Erdos1144 :=
  erdos1144_of_absErdos1144_of_measureZeroOneMeasureDomination
    habs
    (positiveErdos1144MeasureZeroOne_of_measurableSet_coordinateTailFrom htail)
    hdom

/-- Final one-sided handoff from absolute unboundedness, the concrete
all-far-tail measurability condition for the positive point event, and equality
of the positive and negative point-event probabilities. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailFromMeasureSymmetry
    (habs : AbsErdos1144)
    (htail : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event)
    (hsym : PositiveNegativeMeasureSymmetry) :
    Erdos1144 :=
  erdos1144_of_absErdos1144_of_coordinateTailFromMeasureDomination
    habs
    htail
    (positiveNegativeMeasureDomination_of_measureSymmetry hsym)

/-- Final one-sided handoff from absolute unboundedness, the concrete
all-far-tail measurability condition for the positive point event, and a
concrete sign symmetry. -/
theorem erdos1144_of_absErdos1144_of_coordinateTailFromSignSymmetry
    (habs : AbsErdos1144)
    (htail : ∀ n,
      MeasurableSet[coordinateTailFromMeasurableSpace n] positiveErdos1144Event)
