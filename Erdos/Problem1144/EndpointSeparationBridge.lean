/-- A real summable absolute cardinality budget produces the corresponding
`ENNReal`-summable cardinality certificate. -/
noncomputable def endpointSeparationAbsScreenCardinalityTailProbabilityCertificate_of_realBudget
    (h : EndpointSeparationAbsScreenCardinalityRealBudgetCertificate) :
    EndpointSeparationAbsScreenCardinalityTailProbabilityCertificate where
